<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <!-- Stock Move List View -->
    <record id="view_stock_move_tree_inherit"  model="ir.ui.view">
        <field name="name">stock.move.tree.inherit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">    
            <xpath expr="//tree" position="inside">
                <field name="staff_location_id" optional="hide"/>                                                     
            </xpath> 
        </field>
    </record> 

    <!-- Detail Operation List View -->
    <record id="view_stock_move_line_detailed_operation_staff_location" model="ir.ui.view">
        <field name="name">stock.move.line.staff_location</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="staff_location_id" optional="hide" column_invisible="context.get('picking_code') != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo> 