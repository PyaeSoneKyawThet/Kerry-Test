<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- tree view -->
    <record id="asset_report_view_tree" model="ir.ui.view"> 
        <field name="name">asset.report.view.tree</field>
        <field name="model">asset.report</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" type="object">
                <field name="asset_name" optional="show"/>
                <field name="depreciation_date" optional="show"/>
                <field name="fixed_asset_account_id" optional="show"/>
                <field name="depreciation_account_id" optional="show"/>
                <field name="depreciation_expense_account_id" optional="show"/>
                <field name="model_id" optional="show"/>
                <field name="depreciation_rate" optional="show"/>
                <field name="duration" optional="show"/>
                <field name="method_period" optional="show"/>
                <field name="useful_life" optional="show"/>

                <field name="asset_method" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="description" optional="show"/>
                <field name="staff_location_id" optional="show"/>
                <field name="analytic_distribution" widget="analytic_distribution"
                groups="analytic.group_analytic_accounting" optional="show"/>

                <field name="employee_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="bill_date" optional="show"/>

                <field name="prorata_date" optional="show"/>
                <field name="move_id" optional="show"/>
                <field name="vendor_invoice_no" optional="show"/>
                <field name="brand_id" optional="show"/>
                <field name="model_serial_no" optional="show"/>
                <field name="old_fixe_asset" optional="show"/>
                <field name="lot_name" string="Fixed Asset (FA) Tag" optional="show"/>

                <field name="reference_seq" optional="show"/>
                <field name="quantity" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>

                <field name="currency_rate" optional="show"/>
                <field name="original_value" optional="show"/>
                <field name="depreciation_value" optional="show"/>
                <field name="asset_depreciated_value" optional="show"/>
                <field name="year_to_date" optional="show"/>
                <field name="asset_remaining_value" optional="show"/>
                <field name="state" widget="badge" optional="show"/>
            </tree>
        </field> 
    </record>


    <record id="asset_report_search_view" model="ir.ui.view">
        <field name="name">asset.report.search</field>
        <field name="model">asset.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_name"/>
                <field name="depreciation_date"/>
                <field name="fixed_asset_account_id"/>
                <field name="depreciation_account_id"/>
                <field name="depreciation_expense_account_id"/>
                <field name="model_id"/>
                <field name="depreciation_rate"/>
                <field name="duration"/>
                <field name="method_period"/>
                <field name="useful_life"/>

                <field name="asset_method"/>
                <field name="product_id"/>
                <field name="description"/>
                <field name="staff_location_id"/>
                <field name="analytic_distribution" widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting"/>

                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="partner_id"/>
                <field name="bill_date"/>

                <field name="prorata_date"/>
                <field name="move_id"/>
                <field name="vendor_invoice_no"/>
                <field name="brand_id"/>
                <field name="model_serial_no"/>
                <field name="old_fixe_asset" />
                <field name="lot_name" string="Fixed Asset (FA) Tag"/>

                <field name="reference_seq"/>
                <field name="quantity"/>
                <field name="price_unit"/>

                <field name="currency_rate"/>
                <field name="original_value"/>
                <field name="depreciation_value"/>
                <field name="asset_depreciated_value"/>
                <field name="asset_remaining_value"/>
                <field name="state" widget="badge" />
            </search>
        </field>
    </record>


    <record id="action_asset_report" model="ir.actions.act_window">
        <field name="name">Asset Report</field>
        <field name="res_model">asset.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="account_asset_extend.asset_report_view_tree"/>
        <field name="domain">[]</field>
        <!-- <field name="search_view_id" ref="asset_report_search_view"/> -->
        <field name="context">{}</field>
        <field name="target">current</field>
    </record>


    <menuitem id="menu_asset_report" 
    name="Asset Report" 
    parent="account.menu_finance_reports"
    action="account_asset_extend.action_asset_report"
    sequence="50"
    />

</odoo>
