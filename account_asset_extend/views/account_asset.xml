<odoo>
    <data>
        <record id="account_asset_inherit_from_view" model="ir.ui.view">
            <field name="name">account.asset.inherit.form</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">                   
                <xpath expr="//page[@name='main_page']//group" position="inside">
                    <group invisible="state == 'model'" name="other_info" string="Other Info">
                        <field name="employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="department_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="old_fixe_asset"/>
                        <field name="lot_name" string="Fixed Asset (FA) Tag"/>
                        <field name="model_serial_no"/>
                        <field name="remark"/>
                    </group>
                    <group invisible="state == 'model'" name="receipt_info" string="Receipts Info">
                        <field name="picking_id" readonly="state == 'open'" domain="[('picking_type_code', '=', 'incoming')]"
                        options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="product_id" readonly="state == 'open'"
                        options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="location_dest_id" readonly="state == 'open'" domain="[('usage', '=', 'internal')]"
                        options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="staff_location_id" readonly="state == 'open'"
                        options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group invisible="state == 'model'" name="bill_info" string="Bills Info">
                        <field name="available_bill_ids" invisible="1"/>
                        <field name="account_move_line_id" readonly="state == 'open'" domain="[('move_type', '=', 'in_invoice'), ('id', 'in', available_bill_ids)]"
                        options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="bill_date" readonly="state == 'open'"
                        options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="partner_id" readonly="state == 'open'"
                        options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='model_id']" position="attributes">
                    <attribute name="required">state != 'model'</attribute>
                </xpath>
                <xpath expr="//div[hasclass('oe_title')]//h1" position="after">             
                    <group invisible="state == 'model'">
                        <field name="reference_seq" string="Reference" readonly="state == 'open'"/>
                    </group>
                    <group invisible="state != 'model'">
                        <field name="code" string="Code"/>
                        <field name="reference_sequence_id"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='depreciation_move_ids']//tree/field[@name='asset_depreciated_value']" position="after">
                    <field name="year_to_date"/>
                </xpath>
            </field> 
        </record>

        <!-- tree view -->
        <record id="view_account_asset_tree_inherit" model="ir.ui.view">
            <field name="name">account.asset.tree.inherit.kmtl</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree//field[@name='name']" position="before">
                    <field name="reference_seq" optional="show"/>
                    <field name="code" optional="hide"/>
                </xpath>

                <xpath expr="//tree//field[@name='name']" position="after">
                    <field name="model_serial_no" optional="hide"/>
                    <field name="lot_name" string="Fixed Asset (FA) Tag" optional="hide"/>
                    <field name="old_fixe_asset" optional="hide"/>
                    <field name="department_id" optional="hide"/>
                    <field name="employee_id" optional="hide"/>
                    <field name="remark" optional="hide"/>
                </xpath>

                <xpath expr="//tree//field[@name='acquisition_date']" position="before">
                    <field name="picking_id" optional="hide"/>
                    <field name="product_id" optional="hide"/>
                    <field name="location_dest_id" optional="hide"/>
                    <field name="staff_location_id" optional="hide"/>
                    <field name="account_move_line_id" optional="hide"/>
                    <field name="bill_date" optional="hide"/>
                    <field name="partner_id" optional="hide"/>
                </xpath>
            </field>
        </record>

        <!-- search view -->
        <record id="view_account_asset_search_inherit" model="ir.ui.view">
            <field name="name">account.asset.search.inherit</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="reference_seq" />
                    <field name="account_asset_id" />
                    <field name="account_depreciation_id" />
                    <field name="account_depreciation_expense_id" />
                    <field name="account_asset_id" />
                    <field name="model_serial_no" />
                    <field name="lot_name" />
                    <field name="old_fixe_asset" />
                    <field name="picking_id" />
                    <field name="department_id" />
                    <field name="employee_id" />
                    <field name="account_move_line_id" />
                    <field name="partner_id" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>