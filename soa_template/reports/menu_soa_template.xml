<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>         
        <record id="paperformat_soa_template" model="report.paperformat">
            <field name="name">SOA Template Paperformat</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">17</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">25</field> 
            <field name="dpi">90</field>
        </record>

        <!-- QWeb Reports -->
        <record id="soa_template_report" model="ir.actions.report">
            <field name="name">SOA Template</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">soa_template.soa_template_print</field>
            <field name="report_file">soa_template.soa_template_print</field>
            <field name="print_report_name">'Follow-up ' + object.display_name</field>
            <field name="paperformat_id" ref="soa_template.paperformat_soa_template"/>
            <field name="attachment"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
