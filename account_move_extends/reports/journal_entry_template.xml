<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="custom_header_footer_journal_entry">
            <div class="header">
                <div style="report_header_style">
                    <div class="row">
                        <div class="col-3"></div>
                        <div class="col-6 fw-bold py-4">
                            <h4 class="text-center">
                                <span>JOURNAL VOUCHER</span> 
                            </h4>
                        </div>
                        <div class="col-3 text-end">
                            <span t-field="doc.company_id.logo"
                                t-options="{'widget':'image', 'style': 'height:85px; width:130px'}" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer" style="margin-bottom: -400px  !important;">  
                <div class="row text-end" style="height: 25px;">                        
                    <p><small>
                        Page: <span class="page"/> / <span class="topage"/>
                        <span class="ms-2" t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M:%S')"/>
                    </small></p>   
                </div>  
                <div style="border-top: 1px solid black;">
                    <span t-if="doc.company_id.company_footer" t-field="doc.company_id.company_footer" 
                    t-options="{'widget':'image','style': 'height:80px; width:900px'}"/>
                </div>                                                   
            </div>

        </template>

        <template id="custom_journal_entry">
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
                <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat" /> <!-- So that it
                appears in the footer of the report instead of the company VAT if it's set -->

                <div class="page" style="">
                    <div class="row mb-3" style="margin-top: -30px;">
                        <div class="col-9" name="Information 1">
                            <div class="row">
                                <div class="col-5" style="width: 120px;">
                                    <strong>Description</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.ref">
                                    <span t-field="doc.ref" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-5" style="width: 120px;">
                                    <strong>Voucher No</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.name">
                                    <span t-field="doc.name" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-5" style="width: 120px;">
                                    <strong>Exchange Rate</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-6" t-if="doc.currency_rate">
                                    <span t-field="doc.currency_rate" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-3" name="Information 2">
                            <div class="row">
                                <div class="col-5" style="width: 65px;">
                                    <strong>GL Date</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.date">
                                    <span t-field="doc.date" t-options="{'widget': 'date', 'format': 'dd-MMM-YYYY'}"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-5" style="width: 65px;">
                                    <strong>Period</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.date">
                                    <span t-field="doc.date" t-options="{'widget': 'date', 'format': 'MMM-YYYY'}"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <t t-if="doc.line_ids">
                        <table class="table table-borderless border-0 mt-1"  style="margin-bottom: 50px;">
                            <tr class="border border-dark border-1 border-start-0 border-end-0 border-bottom-0">
                                <th class="border-0 text-end" style="text-transform: capitalize;">No</th>
                                <th class="border-0 text-start" style="text-transform: capitalize;">Account Code</th>
                                <th class="border-0 text-start" style="text-transform: capitalize;">Account Name</th>
                                <th class="border-0 text-end" style="text-transform: capitalize;">Original Amount</th>
                                <th class="border-0" style="text-transform: capitalize;padding-left:80px;" colspan="2">Amount</th>
                                <th class="border-0  d-none"></th>
                            </tr>
                            <tr class="border border-dark border-1  border-top-0 border-start-0 border-end-0 ">
                                <th class="border-0" style="text-transform: capitalize;"></th>
                                <th class="border-0" style="text-transform: capitalize;"></th>
                                <th class="border-0" style="text-transform: capitalize;"></th>
                                <th class="border-0" style="text-transform: capitalize;"></th>
                                <th class="border-0 text-end" style="text-transform: capitalize;">Debit</th>
                                <th class="border-0 text-end" style="text-transform: capitalize;">Credit</th>
                                <th class="border-0 d-none"></th>
                            </tr>
                            <tbody >
                                <t t-set="total_credit" t-value="0" />
                                <t t-set="total_debit" t-value="0" />
                                <t t-set="index" t-value="1" />
                                
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr class="border-0">
                                        <td class="border-0 text-end" >
                                            <span t-esc="index"/>
                                        </td>
                                        <td class="border-0" name="td_account_code">
                                            <span t-field="line.account_id.code"/>
                                        </td>
                                        <td class="border-0" name="td_account_name">
                                            <table style="width: 100%;" class="border-0">
                                                <tr class="border-0">
                                                    <td class="border-0" colspan="2">
                                                        <span t-out="line.account_id.name"/>
                                                    </td>
                                                    <td class="d-none"></td>
                                                </tr>
                                                <t t-set="data_pairs" t-value="[line._get_report_data_ar_invoice()[i:i+2] for i in range(0, len(line._get_report_data()), 2)]"/>
                                                <t t-foreach="data_pairs" t-as="pair">
                                                    <tr class="border-0">
                                                        <t t-foreach="pair" t-as="distribution">
                                                            <td class="border-0 mb-2" style="text-align: start; width: 50%;">
                                                                <t t-esc="distribution['account_name']"/>
                                                            </td>
                                                            <td class="d-none"/>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </table>
                                        </td>
                                        <td name="td_amount_currency" class="text-end border-0">
                                            <span t-out="line.amount_currency" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                        <td name="td_debit" class="text-end border-0">
                                            <span t-field="line.debit" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                        </td>
                                        <t t-set="total_debit" t-value="total_debit + line.debit"></t>
                                        <td name="td_credit" class="text-end border-0">
                                            <span t-field="line.credit" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                        </td>
                                        <t t-set="total_credit" t-value="total_credit + line.credit"></t>
                                        <td class="border-0  d-none"></td>
                                    </tr>
                                    <t t-set="index" t-value="index + 1"/>
                                </t>
    
                                <tr name="Total Row" class="border border-dark border-1 border-start-0 border-end-0" >
                                    <td class="border-0 text-center" colspan="4">
                                        <span>Total</span> 
                                    </td>
                                    <td class="text-end border-0">
                                        <span t-esc="total_debit" t-options="{'widget': 'monetary', 'display_currency': line.company_currency_id}"/>
                                    </td>
                                    <td class="text-end border-0">
                                        <span t-esc="total_credit" t-options="{'widget': 'monetary', 'display_currency': line.company_currency_id}"/>
                                    </td>
                                    <td class="border-0  d-none"></td>
                                </tr>
                            </tbody>
                        </table>   
                    </t>
                    
                    
                    <div class="row" style="margin-top: 200px;">
                        <div class="col-8">
                            <p><strong>Prepared By: </strong><span t-if="doc.create_uid and doc.create_uid.name" ><span t-field="doc.create_uid.name" /></span><span t-if="doc.create_uid and doc.create_uid.name">, </span><span t-field="doc.invoice_submit_date" /></p>
                            <p><strong>Checked By: </strong></p>
                            <p><strong>Approved By: </strong></p>
                        </div>

