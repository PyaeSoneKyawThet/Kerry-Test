                    </div>

                </div>
            </t>
        </template>

        <template id="journal_entry_print">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="account_move_extends.custom_header_footer_journal_entry" />
                    <t t-set="lang" t-value="doc.partner_id.lang" />
                    <t t-call="account_move_extends.custom_journal_entry" t-lang="lang" />
                </t>
            </t>
        </template>
    </data>
</odoo>