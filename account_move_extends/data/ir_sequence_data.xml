<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">  
        <record id="seq_customer_payment_with_journal_short_code" model="ir.sequence">
            <field name="name">Customer Payment Sequence</field>
            <field name="code">customer.payment.with.journal</field>
            <field name="padding">5</field>
            <field name="prefix">-%(year)s-</field>
            <field name="company_id" eval="False"></field>
        </record>    

        <record id="seq_vendor_payment_with_journal_short_code" model="ir.sequence">
            <field name="name">Vendor Payment Sequence</field>
            <field name="code">vendor.payment.with.journal</field>
            <field name="padding">5</field>
            <field name="prefix">-%(year)s-</field>
            <field name="company_id" eval="False"></field>
        </record>    

        
    </data>     
</odoo>