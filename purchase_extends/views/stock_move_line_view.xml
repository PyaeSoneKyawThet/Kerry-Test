<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <!-- Stock Move List View -->
    <record id="view_stock_move_tree_inherit"  model="ir.ui.view">
        <field name="name">stock.move.tree.inherit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">    
            <xpath expr="//tree" position="inside">
                <field name="category_id" optional="hide"/>
                <field name="brand_id" optional="hide"/>
                <field name="purchase_order_id" string="PO No" optional="hide"/>
                <field name="vendor_invoice_no" optional="hide"/>
                <field name="vehicle_no" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="owner_id" string="Assign Owner" optional="hide"/>                                                      
            </xpath> 
        </field>
    </record> 

    <!-- Detail Operation List View -->
    <record id="view_stock_move_line_detailed_operation_custom" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.custom.tree</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="product_category_name" optional="hide"/>
                <field name="brand_id" optional="hide" column_invisible="context.get('picking_code') != 'incoming'"/>
                <field name="vehicle_no" optional="hide"/>
                <field name="purchase_order_id" string="PO No" optional="hide" column_invisible="context.get('picking_code') != 'incoming'"/>
                <field name="vendor_invoice_no" optional="hide" column_invisible="context.get('picking_code') != 'incoming'"/>
                <field name="delivery_date" optional="hide" column_invisible="context.get('picking_code') != 'incoming'"/>
                <field name="owner_id" string="Assign Owner" optional="hide" column_invisible="context.get('picking_code') != 'incoming'"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_custom" model="ir.ui.view">
        <field name="name">stock.move.line.custom.tree</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="product_category_name" optional="hide"/>
                <field name="brand_id" optional="hide"/>
                <field name="vehicle_no" optional="hide"/>
                <field name="purchase_order_id" string="PO No" optional="hide"/>
                <field name="vendor_invoice_no" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="owner_id" string="Assign Owner" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo> 