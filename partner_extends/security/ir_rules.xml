<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.rule" id="partner_sales_pic">
            <field name="name">Partner By Sales PIC</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="domain_force">['|',('sale_pic_ids', '=', False), ('sale_pic_ids', 'in', user.ids)]</field>
        </record>

        <record model="ir.rule" id="partner_all_sales_pic">
            <field name="name">Partner By Sales PIC for Admin</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('account.group_account_invoice'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>

</odoo>
