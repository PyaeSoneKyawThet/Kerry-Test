<?xml version="1.0" encoding="UTF-8"?> 
<odoo>    
    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="context">
            {'default_is_company': True, 'create_new_contact': True} 
        </field>
    </record>  

    <record id="view_partner_form_custom" model="ir.ui.view"> 
        <field name="name">view.partner.form.custom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml"> 
            <xpath expr="//sheet//group//group[2]//field[@name='function']" position="after">
                <field name="contact_person" />
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="ref" readonly="1" />           
            </xpath>  
            <xpath expr="//group[@name='sale']//field[@name='user_id']" position="after">
                <field name="sale_pic_ids" widget="many2many_tags"/>           
            </xpath>
            <xpath expr="//group[@name='sale']//field[@name='property_product_pricelist']" position="after">
                <field name="type_id"/>           
            </xpath>  
            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="vendor_bank_info" />           
            </xpath>      
        </field>
    </record>

    <record id="view_partner_tree_custom" model="ir.ui.view"> 
        <field name="name">view.partner.tree.custom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml"> 
            <xpath expr="//tree" position="inside">
                <field name="contact_person" optional="hide"/>
                <field name="ref" readonly="1" optional="hide"/> 
                <field name="type_id" optional="hide"/> 
                <field name="sale_pic_ids" widget="many2many_tags" optional="hide"/>  
                <field name="vendor_bank_info" optional="hide"/>                  
            </xpath>
        </field>
    </record>

</odoo>