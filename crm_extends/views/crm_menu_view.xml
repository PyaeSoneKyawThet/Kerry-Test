<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_industry_action" model="ir.actions.act_window">
        <field name="name">Industries</field>
        <field name="res_model">crm.industry</field>
        <field name="view_mode">tree,form</field>
        <field name="domain"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Industry found. Let's create one!
            </p><p>
                <!-- Receipts allow you to get products from a partner. -->
            </p>
        </field>
    </record>

    <record id="crm_unit_action" model="ir.actions.act_window">
        <field name="name">Industries</field>
        <field name="res_model">crm.unit</field>
        <field name="view_mode">tree,form</field>
        <field name="domain"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Unit found. Let's create one!
            </p><p>
                <!-- Receipts allow you to get products from a partner. -->
            </p>
        </field>
    </record>

    <menuitem
        id="crm_config_industry_menu"
        name="Industries"
        parent="crm.crm_menu_config"
        action="crm_industry_action"
        groups="sales_team.group_sale_manager"
        sequence="12"/>

    <menuitem
        id="crm_config_unit_menu"
        name="Unit"
        parent="crm.crm_menu_config"
        action="crm_unit_action"
        groups="sales_team.group_sale_manager"
        sequence="13"/>

</odoo>