<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <record id="sale_order_form_inherit_crm" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.crm</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">   
            <xpath expr="//field[@name='partner_id']" position="after">   
                <field name="commodity"/>              
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="crm_ref" invisible="1"/>
                <field name="opportunity_ids" widget="many2many_tags" string="CRM Ref"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_inherit_crm" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.crm</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">   
            <xpath expr="//field[@name='partner_id']" position="after">   
                <field name="commodity" optional="hide"/>
                <field name="opportunity_ids" widget="many2many_tags" string="CRM Ref" optional="hide"/>              
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_crm" model="ir.ui.view">
        <field name="name">sale.quotation.tree.crm</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">   
                <field name="commodity" optional="hide"/>
                <field name="opportunity_ids" widget="many2many_tags" string="CRM Ref" optional="hide"/>              
            </xpath>
        </field>
    </record>
</odoo>