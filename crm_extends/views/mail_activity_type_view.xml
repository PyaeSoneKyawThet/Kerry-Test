<odoo>
    <data>
        <record id="mail_activity_type_view_form_inherit" model="ir.ui.view">
            <field name="name">mail.activity.type.view.form.inherit</field>
            <field name="model">mail.activity.type</field>
            <field name="inherit_id" ref="mail.mail_activity_type_view_form"/> 
            <field name="arch" type="xml">
                <xpath expr="//group[@name='activity_planning']" position="inside">
                    <field name="is_follow_up_activity"/>
                    <field name="follow_up_message" invisible="not is_follow_up_activity"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>