<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.rule" id="crm_sales_pic">
            <field name="name">CRM By Sales PIC</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('account.group_account_invoice'))]"/>
            <field name="domain_force">['|',('partner_id.sale_pic_ids', '=', False), ('partner_id.sale_pic_ids', 'in', user.ids)]</field>
        </record>

        <record model="ir.rule" id="crm_all_sales_pic">
            <field name="name">CRM By Sales PIC for Admin</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Forecast Revenue record rules (same pattern as CRM Lead) -->
        <record model="ir.rule" id="forecast_revenue_company_rule">
            <field name="name">Forecast Revenue Multi Company</field>
            <field name="model_id" ref="model_customer_forecast_revenue"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record model="ir.rule" id="forecast_revenue_sales_pic">
            <field name="name">Forecast Revenue By Sales PIC</field>
            <field name="model_id" ref="model_customer_forecast_revenue"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('account.group_account_invoice'))]"/>
            <field name="domain_force">['|', '|', ('customer_id', '=', False), ('customer_id.sale_pic_ids', '=', False), ('customer_id.sale_pic_ids', 'in', user.ids)]</field>
        </record>

        <record model="ir.rule" id="forecast_revenue_all_sales_pic">
            <field name="name">Forecast Revenue By Sales PIC for Admin</field>
            <field name="model_id" ref="model_customer_forecast_revenue"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>

</odoo>
