<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- wizard action form view -->
        <record id="view_form_select_partner_wizard" model="ir.ui.view">
            <field name="name">select.partner.wizard</field>
            <field name="model">wizard.select.partner</field>            
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="crm_ids" widget="many2many_tags" invisible="1"/>                                       
                        <field name="partner_id" required="1"/>                                                                                                                                                       
                    </group>   
                    <footer>
                        <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>                                                               
                </form>
            </field>
        </record>

    </data>
</odoo>
