<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- tree view -->
    <record id="performance_quanity_report_tree" model="ir.ui.view"> 
        <field name="name">performance.qunatity.report.view.tree</field>
        <field name="model">performance.qunatity.report</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" type="object">
                <field name="user_id" optional="show"/>
                <field name="hunting" optional="show" sum="Total"/>
                <field name="projected" optional="show" sum="Total"/>   
                <field name="awarded" optional="show" sum="Total"/>   
                <field name="loss" optional="show" sum="Total"/> 
                <field name="convertion_rate" optional="show" sum="Total"/>               
            </tree>
        </field> 
    </record>

    <!-- search view -->
    <record id="performance_quanity_report_search" model="ir.ui.view">
        <field name="name">performance.qunatity.report.search</field>
        <field name="model">performance.qunatity.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
            </search>
        </field>
    </record>

    <record id="action_performance_qunatity_report" model="ir.actions.act_window">
        <field name="name">Performance by Quantity Report</field>
        <field name="res_model">performance.qunatity.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm_extends.performance_quanity_report_tree"/>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="performance_quanity_report_search"/>
        <field name="context">{}</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_performance_qunatity_report" 
    name="Performance by Quantity" 
    parent="crm.crm_menu_report"
    action="action_performance_qunatity_report"
    sequence="100"
    />
</odoo>
