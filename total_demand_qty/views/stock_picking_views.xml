<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <record id="view_stock_picking_form_total_qty" model="ir.ui.view">
        <field name="name">view.stock.picking.form.total.qty</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">  
            <xpath expr="//page[@name='operations']/button" position="before">
                <group class="oe_subtotal_footer">
                    <label class="mw-50" for="total_demand_quantity"/>
                    <div class="o_row">
                        <span><field name="total_demand_quantity" nolabel="1"/></span>
                    </div> 
                    <label class="mw-50" for="total_quantity"/>
                    <div class="o_row">
                        <span><field name="total_quantity" nolabel="1"/></span>
                    </div>   
                </group>
            </xpath>     
        </field>
    </record>

    <record id="vpicktree_total_quantity" model="ir.ui.view">
        <field name="name">view.stock.picking.tree.total.qty</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">       
            <xpath expr="//field[@name='origin']" position="after">
                <field name="total_demand_quantity"/>
                <field name="total_quantity"/>
            </xpath>
        </field>
    </record>
</odoo>