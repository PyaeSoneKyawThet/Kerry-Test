<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_ap_invoice_tracking_report_form" model="ir.ui.view">
        <field name="name">kmtl.ap.invoice.tracking.report.wizard.form</field>
        <field name="model">kmtl.ap.invoice.tracking.report</field>
        <field name="arch" type="xml">
            <form string="AP Invoice Tracking Report">
                <sheet>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="staff_location_ids" widget="many2many_tags"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="payment_term_ids" widget="many2many_tags"/>
                        <field name="state_ids" widget="many2many_tags"/>
                        <field name="currency_ids" widget="many2many_tags"/>
                        <field name="account_ids" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <button string="Export XLSX" type="object" name="action_export_xlsx" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ap_invoice_tracking_report_wizard" model="ir.actions.act_window">
        <field name="name">AP Invoice Tracking Report</field>
        <field name="res_model">kmtl.ap.invoice.tracking.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wizard_ap_invoice_tracking_report_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_kmtl_ap_invoice_tracking_report"
              name="AP Invoice Tracking Report"
              parent="menu_kmtl_reports_root"
              action="action_ap_invoice_tracking_report_wizard"/>
</odoo>
