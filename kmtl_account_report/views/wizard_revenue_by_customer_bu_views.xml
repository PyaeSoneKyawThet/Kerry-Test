<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_revenue_by_customer_bu_form" model="ir.ui.view">
        <field name="name">kmtl.revenue.by.customer.bu.wizard.form</field>
        <field name="model">kmtl.revenue.by.customer.bu</field>
        <field name="arch" type="xml">
            <form string="Revenue by Customer/BU">
                <sheet>
                    <group>
                        <field name="bu_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                    </group>
                    <footer>
                        <button string="Export XLSX" type="object" name="action_export_xlsx" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_revenue_by_customer_bu_wizard" model="ir.actions.act_window">
        <field name="name">Revenue by Customer/BU</field>
        <field name="res_model">kmtl.revenue.by.customer.bu</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wizard_revenue_by_customer_bu_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_kmtl_revenue_by_customer_bu"
              name="Revenue by Customer/BU"
              parent="account.menu_finance_reports"
              action="action_revenue_by_customer_bu_wizard"/>
</odoo>
