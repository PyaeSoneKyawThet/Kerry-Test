<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_revenue_by_customer_form" model="ir.ui.view">
        <field name="name">kmtl.revenue.by.customer.wizard.form</field>
        <field name="model">kmtl.revenue.by.customer</field>
        <field name="arch" type="xml">
            <form string="Revenue by Customer">
                <sheet>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="group_by"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <!-- <field name="currency_id"/> -->
                    </group>
                    <footer>
                        <button string="Export XLSX" type="object" name="action_export_xlsx" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action and menu placed under Accounting -> Reporting -->

    <record id="action_revenue_by_customer_wizard" model="ir.actions.act_window">
        <field name="name">Revenue by Customer</field>
        <field name="res_model">kmtl.revenue.by.customer</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wizard_revenue_by_customer_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_kmtl_revenue_by_customer" name="Revenue by Customer" parent="kmtl_account_report.menu_kmtl_reports_root" action="action_revenue_by_customer_wizard"/>


</odoo>

