<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_invoice_list_report_form" model="ir.ui.view">
        <field name="name">kmtl.invoice.list.report.wizard.form</field>
        <field name="model">kmtl.invoice.list.report</field>
        <field name="arch" type="xml">
            <form string="Invoice List Report">
                <sheet>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="currency_ids" widget="many2many_tags"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <button string="Export XLSX" type="object" name="action_export_xlsx" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_invoice_list_report_wizard" model="ir.actions.act_window">
        <field name="name">Invoice List Report</field>
        <field name="res_model">kmtl.invoice.list.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wizard_invoice_list_report_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_kmtl_invoice_list_report" name="Invoice List Report" parent="menu_kmtl_reports_root" action="action_invoice_list_report_wizard"/>
</odoo>
