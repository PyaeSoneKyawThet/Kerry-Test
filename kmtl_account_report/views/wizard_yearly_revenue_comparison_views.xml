<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_yearly_revenue_comparison_form" model="ir.ui.view">
        <field name="name">kmtl.yearly.revenue.comparison.wizard.form</field>
        <field name="model">kmtl.yearly.revenue.comparison</field>
        <field name="arch" type="xml">
            <form string="Yearly Revenue Comparison">
                <sheet>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                    </group>
                    <footer>
                        <button string="Export XLSX" type="object" name="action_export_xlsx" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_yearly_revenue_comparison_wizard" model="ir.actions.act_window">
        <field name="name">Yearly Revenue Comparison</field>
        <field name="res_model">kmtl.yearly.revenue.comparison</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wizard_yearly_revenue_comparison_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_kmtl_yearly_revenue_comparison"
              name="Yearly Revenue Comparison"
              parent="account.menu_finance_reports"
              action="action_yearly_revenue_comparison_wizard"/>
</odoo>
