<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- tree view -->
    <record id="purchase_approval_config_tree_view" model="ir.ui.view"> 
        <field name="name">Purchase Approval Config</field>
        <field name="model">purchase.approval.config</field>
        <field name="arch" type="xml">
            <tree string="Approval Config" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="from_amount"/>
                <field name="to_amount"/>
                <field name="need_approval"/>
                <field name="currency_id" required="1"/>
                <field name="from_level" required="1"/>
                <field name="to_level" required="1"/>
            </tree>
        </field> 
    </record>

    <!-- form view -->
    <record id="purchase_approval_config_form_view" model="ir.ui.view"> 
        <field name="name">Purchase Approval Config</field>
        <field name="model">purchase.approval.config</field>
        <field name="arch" type="xml">
            <form string="Approval Config">
                <sheet>
                    <group>
                        <field name="from_amount"/>
                        <field name="to_amount"/>
                        <field name="currency_id" required="1"/>
                        <field name="need_approval"/>
                        <field name="from_level" required="1"/>
                        <field name="to_level" required="1"/>
                    </group>
                </sheet>
            </form>
        </field> 
    </record>

    <record id="action_purchase_approval_config" model="ir.actions.act_window">
        <field name="name">Purchase Approval Config</field>
        <field name="res_model">purchase.approval.config</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>
</odoo>