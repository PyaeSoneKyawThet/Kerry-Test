<odoo>
    <data>
        <record id="view_employee_form_inherit" model="ir.ui.view">
            <field name="name">view.employee.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">                
                <xpath expr="//page[@name='hr_settings']" position="after">  
                    <page name="Approvers">
                        <group string="Approvers">
                            <group>
                                <field name="job_order_approver_id" context="{'default_company_id': company_id}" widget="many2one_avatar_user"/>
                            </group>
                            <group>
                                <field name="quotation_approver_id" string="Quotation Approver" context="{'default_company_id': company_id}" widget="many2one_avatar_user"/> 
                            </group>
                        </group>
                        <group>
                            <group string="Approval Approver" >
                                <field name="approver_ids" nolabel="1" colspan="2">   
                                    <tree editable="bottom" >
                                        <field name="sequence" widget="handle"/>
                                        <field name="approval_employee_id" string="User" required="0" column_invisible="1"/>               
                                        <field name="approval_user_ids" string="Users" widget="many2many_tags" 
                                               required="1" options="{'no_create': True, 'no_create_edit': True}"/>               
                                        <field name="sequence" string="Level"/>
                                    </tree>                         
                                </field>  
                            </group> 
                            <group string="Purchase Approver" >
                                <field name="purchase_approver_ids" nolabel="1" colspan="2">   
                                    <tree editable="bottom" >
                                        <field name="sequence" widget="handle"/>
                                        <field name="approval_employee_id" string="User" required="0" column_invisible="1"/>                  
                                        <field name="approval_user_ids" string="Users" widget="many2many_tags" 
                                               required="1" options="{'no_create': True, 'no_create_edit': True}"/>              
                                        <field name="sequence" string="Level"/>
                                    </tree>                         
                                </field>  
                            </group> 
                        </group>

                        <group >
                            <group string="Invoice Approver" >
                                <field name="invoice_approver_ids" nolabel="1" colspan="2">   
                                    <tree editable="bottom" >
                                        <field name="sequence" widget="handle"/>
                                        <field name="approval_employee_id" string="User" required="0" column_invisible="1"/>                
                                        <field name="approval_user_ids" string="Users" widget="many2many_tags" 
                                               required="1" options="{'no_create': True, 'no_create_edit': True}"/>                
                                        <field name="sequence" string="Level"/>
                                    </tree>                         
                                </field>  
                            </group>   
                            <group string="Bill Approver">
                                <field name="bill_approver_ids" nolabel="1" colspan="2">   
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="approval_employee_id" string="User" required="0" column_invisible="1"/>                 
                                        <field name="approval_user_ids" string="Users" widget="many2many_tags" 
                                               required="1" options="{'no_create': True, 'no_create_edit': True}"/>               
                                        <field name="sequence" string="Level"/>
                                    </tree>                         
                                </field>  
                            </group>  
                        </group>
                        
                        <group>
                            <group string="Customer Payment Approver">
                                <field name="customer_payment_approver_ids" nolabel="1" colspan="2">   
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="approval_employee_id" string="User" required="0" column_invisible="1"/>                  
                                        <field name="approval_user_ids" string="Users" widget="many2many_tags" 
                                               required="1" options="{'no_create': True, 'no_create_edit': True}"/>              
                                        <field name="sequence" string="Level"/>
                                    </tree>                         
                                </field>  
                            </group>  
                            <group string="Vendor Payment Approver">
                                <field name="vendor_payment_approver_ids" nolabel="1" colspan="2">   
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="approval_employee_id" string="User" required="0" column_invisible="1"/>                
                                        <field name="approval_user_ids" string="Users" widget="many2many_tags" 
                                               required="1" options="{'no_create': True, 'no_create_edit': True}"/>                
                                        <field name="sequence" string="Level"/>
                                    </tree>                         
                                </field>  
                            </group>   
                        </group>
                           
                    </page>                 
                                                        
                </xpath>              
            </field>
        </record>
    </data>
</odoo>