<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <record id="view_move_form_inherit_job_order" model="ir.ui.view">
        <field name="name">sale.account.move.joborder</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/> 
        <field name="arch" type="xml"> 
            <xpath expr="//group[@id='header_left_group']" position="inside"> 
                <!-- <field name="job_order_id" invisible="move_type not in ['out_invoice']"/>  -->
                <field name="job_order_type" invisible="move_type not in ['out_invoice']"/>
                <!-- no longer used -->
                <!-- <field name="project_name" invisible="move_type not in ['out_invoice']"/>  -->
                <field name="job_sub_service" invisible="move_type not in ['out_invoice']"/> 
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='product_id']" position="attributes">
                <attribute name="width">90px</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='name']" position="attributes">
                <attribute name="width">90px</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='account_id']" position="attributes">
                <attribute name="width">90px</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='analytic_distribution']" position="attributes">
                <attribute name="width">100px</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='name']" position="after">
                <field name="job_order_id" column_invisible="parent.move_type in ['in_invoice']" widget="many2one_barcode" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="quotation_salesperson_id" string="Quotation Salesperson" widget="many2one_avatar_user" options="{'no_create': True}" column_invisible="parent.move_type in ['in_invoice']" width="100px"/>
                <field name="fmis_job_no" required="parent.job_order_type in ('transport')" width="100px"/>   
                <field name="bl_no" required="0" width="100px"/> 
                <field name="job_date" width="100px"/>              
                <field name="vehicle_no" required="0" width="100px"/>                
                <field name="vehicle_type_id" required="0" column_invisible="parent.move_type in ['in_invoice']" width="100px"/>                
                <field name="container_no" required="0" column_invisible="parent.move_type in ['in_invoice']" width="100px"/>                
                <field name="container_type_id" required="0" column_invisible="parent.move_type in ['in_invoice']" width="100px"/>                
            </xpath>

            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="staff_location_id" required="1"/>
                <field name="attachment_ids" widget="many2many_binary" string="Attach a file" readonly="state in ['posted']" invisible="move_type not in ['out_invoice']"/>  
                <field name="job_date" readonly="0" force_save="1" invisible="move_type in ['entry']"/>
            </xpath>

            <xpath expr="//field[@name='narration'][1]" position="before">
                <field name="remark" placeholder="Remark" colspan="2" nolabel="1"/>
            </xpath>

            <xpath expr="//page[@name='other_info']" position="inside">
                <group id="delivery_tag" >
                    <group string="Delivery"
                           name="delivery_info_group">
                        <field name="commodity" invisible="job_order_type in ('transport','warehouse','dry_port')"/>
                        <field name="pol" invisible="job_order_type in ('transport','warehouse','dry_port')"/>
                        <field name="pod" invisible="job_order_type in ('transport','warehouse','dry_port')"/>
                        <field name="freight_payment_term" invisible="job_order_type in ('transport','warehouse','dry_port')"/>
                    </group>
                    <group string="Tracking" 
                           name="tracking_title_group"
                           >
                           <field name="hbl_hawb_no" invisible="job_order_type in ('transport','warehouse')" required="0"/>
                           <field name="mbl_mawb_no" invisible="job_order_type in ('transport','warehouse')" required="0"/>
                           <field name="vessel_voyage_no" invisible="job_order_type in ('transport','warehouse')" required="0"/>
                           <field name="no_of_vehicle"  required="0"/>
                           <field name="shipper" required="0"/>
                           <field name="consignee" required="0"/>
                           <field name="notify_party" required="0"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="sale_account_invoice_form_job_order" model="ir.ui.view">
        <field name="name">sale.account.move.job.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="sale.account_invoice_form"/> 
        <field name="arch" type="xml"> 
            <xpath expr="//button[@name='action_view_source_sale_orders']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_job_orders" type="object" icon="fa-pencil-square-o" invisible="job_order_count == 0 or move_type not in ('out_invoice', 'out_refund', 'out_receipt')">
                    <field string="Job Order" name="job_order_count" widget="statinfo"/>
                </button>
            </xpath> -->
        </field>
    </record> 
    <record id="view_move_line_tree_inherit_job_fields" model="ir.ui.view">
        <field name="name">account.move.line.tree.inherit.job.fields</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="job_order_id"/>
                <field name="quotation_salesperson_id"/>
                <field name="fmis_job_no"/>
                <field name="bl_no"/>
                <field name="job_date"/>
                <field name="inv_job_date" optional="hide"/>
                <field name="job_order_type" optional="hide"/>
                <field name="job_sub_service" optional="hide"/>
                <field name="vehicle_no"/>
                <field name="vehicle_type_id" optional="hide"/>
                <field name="container_no" optional="hide"/>
                <field name="container_type_id" optional="hide"/>
                <field name="attachment_ids" widget="many2many_binary" string="Attach a file" optional="hide"/>  
            </xpath>
        </field>
    </record>
    
    <record id="view_out_invoice_tree_inherit_kmtl" model="ir.ui.view">
        <field name="name">account.move.inherit.view.tree.kmtk</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree//field[@name='invoice_date_due']" position="after">
                <field name="job_date" optional="hide"/>
                 <field name="job_order_type" optional="hide"/>
                <field name="job_sub_service" optional="hide"/>
            </xpath>
            
        </field>
    </record>
</odoo>