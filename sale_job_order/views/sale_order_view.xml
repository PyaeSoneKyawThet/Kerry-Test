<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <!-- add domain in sale quotation action  -->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">[('is_job_order', '!=', True)]</field>
    </record>

    <!-- add domain in sale quotation action  -->
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="domain">[('is_job_order', '!=', True)]</field>
    </record>

    <record id="sale_order_form_inherit_custom_button" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">   

            <xpath expr="//field[@name='currency_id']" position="before">
               <field name="confirmed_date" readonly="state == 'sale'"/>
            </xpath>
            <xpath expr="//group[@name='partner_details']" position="inside"> 
                <field name="company_currency_id" invisible="1" />    
            </xpath>
            <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][1]" position="attributes"> 
                <attribute name="invisible">not is_job_order or invoice_status != 'to invoice'</attribute>
            </xpath> 
            <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][2]" position="attributes"> 
                <attribute name="invisible">not is_job_order or invoice_status != 'no' or state != 'sale'</attribute>
            </xpath> 
            <xpath expr="//button[@name='action_submit']" position="attributes">               
                <attribute name="invisible">state in ['sale', 'cancel'] or approval_state in ['submitted', 'approved', 'rejected']</attribute>
            </xpath>
            <xpath expr="//button[@name='action_approve']" position="attributes">               
                <attribute name="invisible">not enable_approve or state in ['sale', 'cancel'] or approval_state != 'submitted'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_reject']" position="attributes">               
                <attribute name="invisible">not enable_approve or state in ['sale', 'cancel'] or approval_state != 'submitted'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_resubmit']" position="attributes">               
                <attribute name="invisible">state in ['sale', 'cancel'] or approval_state != 'rejected'</attribute>
            </xpath>  
            <xpath expr="//button[@name='action_VAS_create']" position="attributes">               
                <attribute name="invisible">is_job_order or state not in ['sale'] or approval_state not in ['approved'] or revise_state in ['revise_approved']</attribute>
            </xpath>
            <xpath expr="//button[@name='action_renew']" position="attributes">               
                <attribute name="invisible">is_job_order or state not in ['sale'] or approval_state not  in ['approved'] or revise_state in ['revise_approved']</attribute>
            </xpath>
            
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']" position="attributes">
                <attribute name="column_invisible">not parent.is_job_order </attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='cost']" position="attributes">
                <attribute name="column_invisible">parent.is_job_order </attribute>
            </xpath> 
            <xpath expr="//field[@name='order_line']/tree/field[@name='gross_profit']" position="attributes">
                <attribute name="column_invisible">parent.is_job_order </attribute>
            </xpath>
             <xpath expr="//field[@name='order_line']/tree/field[@name='qty_delivered']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath> 
            <xpath expr="//field[@name='order_line']/tree/field[@name='qty_invoiced']" position="attributes">
                <attribute name="column_invisible">not parent.is_job_order or parent.state !=  'sale'</attribute> 
            </xpath>
             <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale' or approval_state == 'submitted'</attribute>
            </xpath>
            <xpath expr="//field[@name='approved_by_id']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='incoterm_location']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='commitment_date']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='opportunity_id']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='campaign_id']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='medium_id']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//field[@name='source_id']" position="attributes">
                <attribute name="readonly">is_job_order and state ==  'sale'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_revise_request']" position="attributes">               
                <attribute name="invisible">is_job_order or state not in ['sale'] or approval_state not in ['approved'] or revise_state in ['revise_requested','revise_approved']</attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']//field[@name='currency_id']" position="attributes">    
                <attribute name="invisible">not is_job_order</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="attributes">  
                <attribute name="column_invisible">parent.is_job_order</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_total']" position="attributes">    
                <attribute name="column_invisible">parent.is_job_order</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="after">  
                <field name="price_subtotal" column_invisible="not parent.is_job_order" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_total']" position="after">    
                <field name="price_total" column_invisible="not parent.is_job_order" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
            <xpath expr="//group[@name='sale_total']" position="attributes">
                <attribute name="invisible">not is_job_order</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="available_partner_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('id', 'in', available_partner_ids)]</attribute>
            </xpath>
            <xpath expr="//field[@name='category_ids']" position="after">
                <field name="job_order_id" invisible='is_job_order' readonly="state == 'sale'"/>
            </xpath>
            
        </field>
    </record>  

    <record id="sale_order_form_inherit_currency_approval" model="ir.ui.view">
        <field name="name">sale.order.currency.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_extends.sale_order_form_inherit_currency"/> 
        <field name="arch" type="xml"> 
            <xpath expr="//group[@name='sale_reporting']//field[@name='approval_state']" position="attributes">
                <attribute name="invisible">is_job_order</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='inv_currency_id']" position="attributes">
                <attribute name="column_invisible">parent.is_job_order</attribute>
                <attribute name="required">not parent.is_job_order and not display_type and state not in ['cancel']</attribute>
            </xpath>
        </field>
    </record>
</odoo>