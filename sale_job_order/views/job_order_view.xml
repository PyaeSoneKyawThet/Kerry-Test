<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <record id="sale_order_form_inherit_job_order" model="ir.ui.view">
        <field name="name">sale.job.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>  
        <field name="arch" type="xml">  
            <xpath expr="//header" position="inside">
                <button name="job_order_report" type="object" data-hotkey="shift+g" string="Print" class="oe_highlight" invisible="not is_job_order or job_order_type not in ('dry_port') or state in ('cancel')"/>
            </xpath>    
            <xpath expr="//div[@name='button_box']" position="inside">    
                <field name="quotation_ref_ids" invisible="1"/>
                <button name="button_open_quotation_ref_ids"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bars"
                        invisible="not quotation_ref_ids or not is_job_order">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Quotation Refs</span>
                    </div>
                </button>
                
            </xpath>
            <xpath expr="//group[@name='partner_details']" position="inside"> 
                <field name="revise_state" invisible="1"/>   
                <field name="is_job_order" invisible="1" />    
                <field name="job_order_type" invisible="not is_job_order"   widget="selection" readonly="state in ['sale']"/>      
                <field name="fmis_inv_number" invisible="not is_job_order" readonly="state in ['sale']"/>  
                <field name="job_sub_service" invisible="not is_job_order" readonly="state in ['sale']"/>  
                <field name="staff_location_id" string="Document Location" invisible="not is_job_order" required="is_job_order" readonly="state in ['sale']"/>   
                <field name="attachment_ids" widget="many2many_binary" string="Attach a file" invisible="not is_job_order" readonly="state in ['sale']"/>   
                <field name="received_customer_id" invisible="not is_job_order or job_order_type not in ('dry_port')" required="job_order_type in ('dry_port')" readonly="state in ['sale']"/>   
            </xpath>  
            <xpath expr="//page[@name='revise_reason']" position="attributes">
                <attribute name="invisible">is_job_order</attribute>
            </xpath>
            <xpath expr="//field[@name='opportunity_ids']" position="attributes">
                <attribute name="invisible">is_job_order</attribute>
            </xpath>
            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="required">not is_job_order</attribute>
                <attribute name="invisible">is_job_order</attribute>
            </xpath>
            <xpath expr="//field[@name='opportunity_ids']" position="attributes">
                <attribute name="required">not is_job_order</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_id']" position="attributes">
                <attribute name="invisible">is_job_order</attribute>
            </xpath>
            <xpath expr="//field[@name='category_note']" position="attributes">
                <attribute name="invisible">is_job_order</attribute>
            </xpath>
            <xpath expr="//field[@name='attention_to']" position="after">
                <field name="vas_ref_ids" widget="many2many_tags" readonly="state in ['sale']" 
                domain="[('is_job_order', '!=', True), ('state', 'not in', ['cancel']), 
                ('partner_id', '=', partner_id), ('is_vas', '=', True), ('validity_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
            </xpath>
            <xpath expr="//group[@name='order_details']//field[@name='validity_date']" position="after"> 
                <field name="job_date" invisible="not is_job_order" readonly="state in ['sale']" /> 
                <field name="receipt_date" invisible="not is_job_order" readonly="state in ['sale']"/> 
            </xpath>

            <xpath expr="//group[@name='order_details']//field[@name='payment_term_id']" position="after"> 
                <field name="so_id" invisible="not is_job_order" readonly="state in ['sale']"
                domain="[('is_job_order', '!=', True), ('state', 'not in', ['cancel']), 
                ('partner_id', '=', partner_id), ('is_vas', '!=', True), ('validity_date', '&gt;=', job_date),
                ('revise_state', '!=', 'revise_approved')
                ]"/>
                <field name="quotation_ref_ids" widget="many2many_tags"  invisible="not is_job_order" readonly="state in ['sale']"
                domain="[('is_job_order', '!=', True), ('state', 'not in', ['cancel']), 
                ('partner_id', '=', partner_id), ('is_vas', '!=', True), ('validity_date', '&gt;=', job_date),
                ('revise_state', '!=', 'revise_approved')
                ]"/>
                
            </xpath>

            <xpath expr="//group[@name='sale_shipping']" position="inside">
                <field name="pol" invisible="not is_job_order or job_order_type in ('transport','warehouse','dry_port')" readonly="state in ['sale']"/> 
                <field name="pod" invisible="not is_job_order or job_order_type in ('transport','warehouse','dry_port')" readonly="state in ['sale']"/> 
                <field name="freight_payment_term" invisible="not is_job_order or job_order_type in ('transport','warehouse','dry_port')" 
                readonly="state in ['sale']"/>                          
            </xpath>
            <xpath expr="//field[@name='commodity']" position="attributes">
                <attribute name="readonly">state == 'sale'</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_reporting']" position="inside">    
                <field name="hbl_hawb_no" invisible="not is_job_order or job_order_type in ('transport','warehouse')" required="0"/> 
                <field name="mbl_mawb_no" invisible="not is_job_order or job_order_type in ('transport','warehouse')"      required="0"/> 
                <field name="vessel_voyage_no" invisible="not is_job_order or job_order_type in ('transport','warehouse')"  required="0"/>  
                <field name="no_of_vehicle" invisible="not is_job_order" readonly="state in ['sale']"/>
                <field name="shipper" invisible="not is_job_order"          required="0" readonly="state in ['sale']"/> 
                <field name="consignee"  invisible="not is_job_order"       required="0" readonly="state in ['sale']"/> 
                <field name="notify_party" invisible="not is_job_order"     required="0" readonly="state in ['sale']"/>                
            </xpath>

            <xpath expr="//field[@name='order_line']//tree//field[@name='name']" position="after">
                <field name="fmis_job_no" column_invisible="not parent.is_job_order" width="100px"
                required="parent.job_order_type in ('transport')" optional="hide"/> 
                <field name="bl_no" column_invisible="not parent.is_job_order" width="100px" optional="hide"/>
                <field name="job_date" column_invisible="not parent.is_job_order" width="100px" optional="hide"/>
                <field name="vehicle_no" column_invisible="not parent.is_job_order" width="100px" optional="hide"/> 
                <field name="vehicle_type_id" column_invisible="not parent.is_job_order" width="100px" optional="hide"/> 
                <field name="container_no"  column_invisible="not parent.is_job_order" width="100px" optional="hide"/>
                <field name="container_type_id" column_invisible="not parent.is_job_order" width="100px" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="attributes">
                <attribute name="readonly">state == 'sale'</attribute>
            </xpath> 

            <xpath expr="//field[@name='user_id']" position="replace">
                <label string="Requester" for="user_id" invisible="not is_job_order"/>
                <label string="Salesperson" for="user_id" invisible="is_job_order"/>
                <div>
                    <field name="user_id" widget="many2one_avatar_user" no_label="1"/>
                </div>
            </xpath>
            
        </field>
    </record>

    <record id="sale_stock_form_inherit_job_order" model="ir.ui.view">
        <field name="name">sale.stock.job.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/> 
        <field name="arch" type="xml"> 
            <xpath expr="//field[@name='incoterm']" position="attributes">
                <attribute name="invisible">is_job_order</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_inherit_job_order" model="ir.ui.view">
        <field name="name">sale.order.tree.job.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/> 
        <field name="arch" type="xml"> 
            <!-- To Show Requester in Job Order List View [TASK-3706] -->
            <xpath expr="//field[@name='user_id']" position="attributes"> 
                <attribute name="column_invisible">context.get('default_is_job_order')</attribute>
            </xpath>
            <!-- To Show Requester in Job Order List View [TASK-3706] -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="job_date" optional="show" column_invisible="not context.get('default_is_job_order')"/>
                <field name="confirmed_date" optional="show"/>
                <field name="receipt_date" optional="show" column_invisible="not context.get('default_is_job_order')"/>
                <field name="so_id" optional="show" column_invisible="not context.get('default_is_job_order')"/>
                <field name="requester_id" widget="many2one_avatar_user" optional="show"/> 
                <field name="vas_ref_ids" widget="many2many_tags" optional="show" column_invisible="not context.get('default_is_job_order')"/>
                <field name="is_job_order" optional="hide" column_invisible="not context.get('default_is_job_order')"/>
                <field name="job_order_type" optional="hide" column_invisible="not context.get('default_is_job_order')"/>
                <field name="fmis_inv_number" optional="hide" column_invisible="not context.get('default_is_job_order')"/>
                <field name="job_sub_service" optional="hide" column_invisible="not context.get('default_is_job_order')"/>
                <field name="staff_location_id" optional="hide" column_invisible="not context.get('default_is_job_order')"/>
                <field name="attachment_ids" widget="many2many_tags" optional="hide" column_invisible="not context.get('default_is_job_order')"/>
                <field name="received_customer_id" optional="hide" column_invisible="not context.get('default_is_job_order')"/>
            </xpath>
            <xpath expr="//field[@name='amount_total']" position="attributes">
                <attribute name="column_invisible">not context.get('default_is_job_order')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="invoiced_state" optional="show" widget="badge" column_invisible="not context.get('default_is_job_order')"  decoration-info="invoiced_state in ['to_invoice']" decoration-success="invoiced_state in ['invoiced']"/>
            </xpath>     
        </field>
    </record>

    <record id="view_order_tree_sale_job_order" model="ir.ui.view">
        <field name="name">sale.order.tree.extend.job.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_extends.view_order_tree_sale_extend"/> 
        <field name="arch" type="xml"> 
            <xpath expr="//field[@name='sale_order_template_id']" position="attributes">
                <attribute name="column_invisible">context.get('default_is_job_order')</attribute>
            </xpath>
            <xpath expr="//field[@name='original_so_id']" position="attributes">
                <attribute name="column_invisible">context.get('default_is_job_order')</attribute>
            </xpath>
            <xpath expr="//field[@name='revise_state']" position="attributes">
                <attribute name="column_invisible">context.get('default_is_job_order')</attribute>
            </xpath>
            <xpath expr="//field[@name='is_vas_created']" position="attributes">
                <attribute name="column_invisible">context.get('default_is_job_order')</attribute>
            </xpath>
            <xpath expr="//field[@name='is_vas_created']" position="attributes">
                <attribute name="column_invisible">context.get('default_is_job_order')</attribute>
            </xpath>
            <xpath expr="//field[@name='is_renew_created']" position="attributes">
                <attribute name="column_invisible">context.get('default_is_job_order')</attribute>
            </xpath>
            <xpath expr="//field[@name='approval_state']" position="before">
                <field name="is_reversed" optional="show"/>
            </xpath>   
        </field>
    </record>

    <!-- To Show Requester in Job Order List View [TASK-3706] -->
    <record id="sale_order_tree_inherit_job_order_extend" model="ir.ui.view">
        <field name="name">sale.order.tree.job.order.extend</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_job_order.sale_order_tree_inherit_job_order"/> 
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requester_id']" position="attributes">
                <attribute name="column_invisible">not context.get('default_is_job_order')</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_search_inherit_reversed" model="ir.ui.view">
        <field name="name">sale.order.search.reversed</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Invoiced" domain="[('invoiced_state', '=', 'invoiced')]" name="invoiced_job_order_filter" invisible="not context.get('default_is_job_order')"/>
                <filter string="To Invoice" domain="[('invoiced_state', '=', 'to_invoice')]" name="to_invoice_job_order_filter" invisible="not context.get('default_is_job_order')"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_by_reversed"
                        string="Reversed Status"
                        context="{'group_by': 'is_reversed'}"/>
                <filter name="invoiced_job_order_groupby"
                        string="Invoiced State"
                        context="{'group_by': 'invoiced_state'}"
                        invisible="not context.get('default_is_job_order')"/>
            </xpath>
        </field>
    </record>

    <!-- Job Order For Sale Tree View -->
    <record id="view_job_order_for_sale_tree" model="ir.ui.view">
        <field name="name">sale.order.tree.job.order.for.sale</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Job Order For Sale" create="false" edit="false" delete="false" default_order="job_date desc, name desc">
                <field name="name" string="Number"/>
                <field name="job_date" string="Date"/>
                <field name="partner_id" string="Customer"/>
                <field name="amount_total" string="Revenue" sum="true"/>
                <field name="sale_pic_ids" widget="many2many_tags" string="Sale PIC"/> 
                <field name="invoiced_state" string="Status"/>
            </tree>
        </field>
    </record>

</odoo>