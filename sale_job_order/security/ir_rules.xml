<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_allowed_dry_port" model="res.groups">
            <field name="name">Dry Pot</field>
            <field name="category_id" ref="base.module_category_usability" />
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')),(4, ref('sales_team.group_sale_manager')), 
                                        (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <record model="ir.rule" id="all_so_rule">
            <field name="name">All Sales Orders (Quotation + Job Order)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

         <record model="ir.rule" id="all_so_line_rule">
            <field name="name">All Sales Orders Line (Quotation + Job Order)</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record model="ir.rule" id="sale_order_by_dept_rule">
            <field name="name">Sales Orders By Dept and Saleperson</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('is_job_order', '=', False), '|', ('sale_person_department_id', '=', False), ('sale_person_department_id', 'in', user.department_ids.ids),
            '|', ('user_id', '=', False), ('user_id', 'in', user.ids)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')),(4, ref('sales_team.group_sale_manager')), 
                                        (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <record model="ir.rule" id="so_line_by_order">
            <field name="name">Sales Orders Line by Dept and Saleperson</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.is_job_order', '=', False), '|', ('order_id.sale_person_department_id', '=', False), ('order_id.sale_person_department_id', 'in', user.department_ids.ids),
            '|', ('order_id.user_id', '=', False), ('order_id.user_id', 'in', user.ids)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')),(4, ref('sales_team.group_sale_manager')), 
                                        (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <record model="ir.rule" id="job_order_by_dept">
            <field name="name">Job Orders By Dept and Sale PIC</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('is_job_order', '=', True), '|', ('sale_person_department_id', '=', False), ('sale_person_department_id', 'in', user.department_ids.ids),
                '|',('partner_id.sale_pic_ids', '=', False), ('partner_id.sale_pic_ids', 'in', user.ids)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')),(4, ref('sales_team.group_sale_manager')), 
                                        (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <record model="ir.rule" id="job_order_line_by_dept">
            <field name="name">Job Orders Line By Dept and Sale PIC</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.is_job_order', '=', True), '|', ('order_id.sale_person_department_id', '=', False), ('order_id.sale_person_department_id', 'in', user.department_ids.ids),
                '|',('order_partner_id.sale_pic_ids', '=', False), ('order_partner_id.sale_pic_ids', 'in', user.ids)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')),(4, ref('sales_team.group_sale_manager')), 
                                        (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <record model="ir.rule" id="job_order_by_dept_dry_port">
            <field name="name">Job Orders By Dept and Sale PIC: Dry Port Only</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('is_job_order', '=', True), ('job_order_type', '=', 'dry_port'), 
            '|', ('sale_person_department_id', '=', False), ('sale_person_department_id', 'in', user.department_ids.ids),
            '|',('partner_id.sale_pic_ids', '=', False), ('partner_id.sale_pic_ids', 'in', user.ids)]</field>
            <field name="groups" eval="[(4, ref('group_allowed_dry_port'))]"/>
        </record>

        <record model="ir.rule" id="job_order_line_by_dept_dry_port">
            <field name="name">Job Orders Line By Dept and Sale PIC: Dry Port Only</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.is_job_order', '=', True), ('order_id.job_order_type', '=', 'dry_port'), 
            '|', ('order_id.sale_person_department_id', '=', False), ('order_id.sale_person_department_id', 'in', user.department_ids.ids),
            '|',('order_partner_id.sale_pic_ids', '=', False), ('order_partner_id.sale_pic_ids', 'in', user.ids)]</field>
            <field name="groups" eval="[(4, ref('group_allowed_dry_port'))]"/>
        </record>
    </data>

</odoo>
