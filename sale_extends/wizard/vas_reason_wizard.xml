<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- wizard action form view -->
        <record id="view_form_VAS_reason_wizard" model="ir.ui.view">
            <field name="name">form.VAS.wizard</field>
            <field name="model">wizard.vas.reason</field>            
            <field name="arch" type="xml">
                <form>
                    <group>  
                        <field name="sale_order_id" string="Sale Order" invisible="1"/> 
                        <field name="state" string="State" invisible="1"/>                           
                        <field name="reason" string="Reason"/>                                                                                                                                                       
                    </group>   
                    <footer>
                        <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>                                                               
                </form>
            </field>
        </record>

    </data>
</odoo>
