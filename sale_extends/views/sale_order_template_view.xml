<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <record id="sale_order_template_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.template.form.inherit</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_template_line_ids']//tree//field[@name='product_id']" position="before">
                <field name="categ_id" string="Category" required="not display_type" /> 
            </xpath>
            <xpath expr="//field[@name='sale_order_template_line_ids']//tree//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('categ_id', '=', categ_id)]</attribute> 
            </xpath>
             <xpath expr="//notebook" position="inside">
                <page string="Quotation Header">
                    <field name="quotation_header"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
        