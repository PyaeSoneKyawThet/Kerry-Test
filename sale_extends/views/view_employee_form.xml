<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <record id="view_employee_form_inherit" model="ir.ui.view">
        <field name="name">view_employee_form_inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">           
            <xpath expr="//page[@name='personal_information']//group//group[2]" position="after">
                <group string="Signature">
                    <field name="digital_signature" widget="signature" string="Signature"/>                    
                </group>
            </xpath>
        </field>
    </record>
    
</odoo>