<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document" >
        <!-- remove original address -->
        <xpath expr="//t[@t-set='address']" position="replace">            
        </xpath> 
        
        <!-- remove Invoice Number -->
        <xpath expr="//div[@class='page']//h2[@class='mt-4']" position="replace">
        </xpath>

        <!-- add header and water mark -->
        <xpath expr="//div[@class='page']" position="before">  
            <h1 class="text-center" style="margin-top:-60px; font-weight:bold;">
                <span t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice</span>
                <span t-elif="doc.state in ['draft','sent']">Quotation</span>
                <span t-else="">Job Order</span>
            </h1>  
            <div class="row" t-if="report_type == 'pdf'" style="height:0px; width:100%; margin-left:10%;">
                <div class="col-6" name="watermark" t-if="doc.state in ['draft', 'sent']">
                    <span style="-webkit-transform:rotate(-45deg); color:grey; font-size:10rem; text-align:center; position:absolute; opacity:0.2; padding-top:120px">
                        DRAFT
                    </span>
                </div>
            </div>
        </xpath> 
        
        <!-- customer informations -->
        <xpath expr="//div[@class='page']//div[@class='row mt-4 mb-2' and @id='informations']" position="replace"> 
            
            <div class="row" name="customer_detail" id="informations" style="margin-top: 30px;"> 
                <!-- customer detail -->               
                <div class="col-6 ">
                    <!-- Customer Name -->
                    <div class="row">
                        <div class="col-4 ">
                            <strong>Customer Name</strong>
                        </div>                         
                        <div class="col-6" t-if="doc.partner_id.complete_name">                            
                            :<span t-field="doc.partner_id.complete_name" class="ms-2"/>
                        </div> 
                    </div>
                    <!-- Address -->
                    <div class="row">
                        <div class="col-4"> 
                            <strong>Address</strong>
                        </div>
                        <div class="col-6" t-if="doc.partner_id.contact_address_complete">                    
                            :<span t-field="doc.partner_id.contact_address_complete" class="ms-2"/>
                        </div>
                    </div>
                    <!-- Attention to -->
                    <div class="row" >
                        <div class="col-4">
                            <strong>Attention To</strong>
                        </div>                         
                        <div class="col-6">                    
                            :<span t-field="doc.attention_to" class="ms-2"/>
                        </div>
                    </div>
                </div>

                <!-- Order Details -->
                <div class="col-6" name="order_detail">
                    <!-- Order No-->
                    <div class="row">                        
                        <div class="col-3">
                            <span t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice </span>
                            <span t-elif="doc.state in ['draft','sent']"><strong>Quotation No</strong></span>
                            <span t-else="">
                                <strong>Order No</strong>
                            </span>                        
                        </div>                    
                        <div class="col-7" t-if="doc.name">                                
                            :<span t-field="doc.name" class="ms-2"/>
                        </div> 
                    </div>
                    <!-- Quotation Date -->
                    <div class="row">                        
                        <div class="col-3">
                            <strong t-if="doc.state in ['draft', 'sent']">Quotation Date:</strong>
                            <strong t-else="">Order Date:</strong><br/>
                        </div>
                        
                        <div class="col-7" t-if="doc.date_order">                                
                            :<span t-field="doc.date_order" t-options='{"widget": "date"}' class="ms-2"/>
                        </div>    
                    </div>
                    <!-- Validity Date -->
                    <div class="row">                        
                        <div class="col-3">
                            <strong>Validity Date</strong>
                        </div>                            
                        <div class="col-7" t-if="doc.validity_date">                                
                            :<span t-field="doc.validity_date" class="ms-2"/>
                        </div> 
                    </div>
                </div>
            </div>
            
        </xpath>

        <xpath expr="//div[@class='page']//div[@class='clearfix' and @name='so_total_summary']" position="replace">
        </xpath>
    </template>    

</odoo>