<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_activity_productivity_wizard" model="ir.ui.view">
        <field name="name">activity.productivity.wizard.form</field>
        <field name="model">activity.productivity.wizard</field>
        <field name="arch" type="xml">
            <form string="Activity and Productivity Report">
                <group>
                    <group>
                        <field name="start_date" required="1"/>
                        <field name="end_date" required="1"/>
                    </group>
                    <group>
                        <field name="user_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="generate_xlsx" string="🖨️ Print XLSX" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_activity_productivity_wizard" model="ir.actions.act_window">
        <field name="name">Activity and Productivity Report</field>
        <field name="res_model">activity.productivity.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_activity_productivity_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_activity_productivity_wizard" 
        name="Activity and Productivity Report" 
        parent="crm.crm_menu_report"
        action="custom_sql_reports.action_activity_productivity_wizard"
        sequence="185"
        />
</odoo>
