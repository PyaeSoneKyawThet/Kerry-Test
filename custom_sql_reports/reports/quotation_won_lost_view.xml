<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quotation_won_lost_wizard" model="ir.ui.view">
        <field name="name">quotation.won.lost.wizard.form</field>
        <field name="model">quotation.won.lost.wizard</field>
        <field name="arch" type="xml">
            <form string="Quotation Win / Loss Analysis Report">
                <group>
                    <group>
                        <field name="start_date" required="1"/>
                        <field name="end_date" required="1"/>
                    </group>
                    <group>
                        <field name="user_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="generate_xlsx" string="🖨️ Print XLSX" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_quotation_won_lost_wizard" model="ir.actions.act_window">
        <field name="name">Quotation Win / Loss Analysis Report</field>
        <field name="res_model">quotation.won.lost.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_quotation_won_lost_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_quotation_won_lost_wizard" 
        name="Quotation Win / Loss Analysis Report" 
        parent="crm.crm_menu_report"
        action="custom_sql_reports.action_quotation_won_lost_wizard"
        sequence="180"
        />
</odoo>
