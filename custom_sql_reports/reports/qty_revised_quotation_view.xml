<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qty_revised_quotation_wizard" model="ir.ui.view">
        <field name="name">qty.revised.quotation.wizard.form</field>
        <field name="model">qty.revised.quotation.wizard</field>
        <field name="arch" type="xml">
            <form string="Qty Of Revised Quotation">
                <group>
                    <group>
                        <field name="start_date" required="1"/>
                        <field name="end_date" required="1"/>
                    </group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                        <field name="user_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                        <field name="currency_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="generate_xlsx" string="🖨️ Print XLSX" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qty_revised_quotation" model="ir.actions.act_window">
        <field name="name">Qty Of Revised Quotation</field>
        <field name="res_model">qty.revised.quotation.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_qty_revised_quotation_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_qty_revised_quotation" 
        name="Qty Of Revised Quotation" 
        parent="sale.menu_sale_report"
        action="custom_sql_reports.action_qty_revised_quotation"
        sequence="80"
        />
</odoo>
