<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">  
        <record id="seq_cash_advance_form" model="ir.sequence">
            <field name="name">Cash Advance Form Sequence</field>
            <field name="code">cash.advance.sequence</field>
