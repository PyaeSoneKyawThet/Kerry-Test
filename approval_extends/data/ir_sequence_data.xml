            <!-- <field name="prefix">%(year)s-%(month)s-</field> -->
            <field name="company_id" eval="False"></field>
        </record>

        <record id="seq_po_comparison" model="ir.sequence">
            <field name="name">PO Comparison Sequence</field>
            <field name="code">po.comparison.sequence</field>
            <field name="padding">5</field>
            <!-- <field name="prefix">%(year)s-%(month)s-</field> -->
