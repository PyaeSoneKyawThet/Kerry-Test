<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="expense_cancel_wizard" model="ir.ui.view">
            <field name="name">expense.cancel.wizard.form</field>
            <field name="model">expense.cancel.wizard</field>
            <field name="arch" type="xml">
                <form string="Expense Cancel">
                    <sheet>
                        <group>
                            <field name="is_expense_cancel"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Confirm" type="object" name="action_cancel_bill" class="btn-primary"/>
                        <button string="Discard" class="btn-secondary" special="cancel"/>
                    </footer>  
                </form>
            </field>
        </record>

    </data>
</odoo>