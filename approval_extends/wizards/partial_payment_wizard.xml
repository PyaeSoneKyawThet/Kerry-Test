<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="approval_partial_payment_wizard" model="ir.ui.view">
            <field name="name">partial.payment.wizard.view.form</field>
            <field name="model">partial.payment.wizard</field>
            <field name="arch" type="xml">
                <form string="Partial Payment">
                    <sheet>
                        <group>
                            <group>
                                <field name="amount"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="currency_id" readonly="1"/>
                                <field name="communication"/>
                                <field name="journal_id" invisible="1"/>
                                <field name="payment_request_id" invisible="1"/>
                            </group>
                        </group>                       
                    </sheet>
                    <footer>
                        <button string="Create Payment" type="object" name="action_create_partial_payment" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>       
                </form>
            </field>
        </record>


    </data>
</odoo>
