<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>         

        <record id="paperformat_custom_po_comparison" model="report.paperformat">
            <field name="name">Clear Cash Advance Report Paperformat</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">25</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">25</field> 
            <field name="dpi">90</field>
        </record>

        <!-- QWeb Reports -->
        <record id="po_comparison_report" model="ir.actions.report">
            <field name="name">PO Comparison Print</field>
            <field name="model">po.comparison</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">approval_extends.po_comparison_print</field>
            <field name="report_file">approval_extends.po_comparison_print</field>
            <field name="print_report_name">(object._get_report_filename())</field>
            <field name="paperformat_id" ref="approval_extends.paperformat_custom_po_comparison"/>
            <field name="attachment"/>     
            <!-- <field name="binding_model_id" ref="approval_extends.model_approval_expense"/> -->
            <!-- <field name="binding_type">report</field> -->
        </record>

    </data>
</odoo>
