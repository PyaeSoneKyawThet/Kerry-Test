<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>         

        <record id="paperformat_custom_clear_ca_from_pr" model="report.paperformat">
            <field name="name">Clear Cash Advance Report Paperformat(From Payment Request)</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">17</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">25</field> 
            <field name="dpi">90</field>
        </record>

        <!-- QWeb Reports -->
        <record id="clear_ca_report_from_pr" model="ir.actions.report">
            <field name="name">Clear Cash Advance Print</field>
            <field name="model">approval.payment.request</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">approval_extends.clear_ca_print_from_pr</field>
            <field name="report_file">approval_extends.clear_ca_print_from_pr</field>
            <field name="print_report_name">(object._get_report_clear_cash_filename())</field>
            <field name="paperformat_id" ref="approval_extends.paperformat_custom_clear_ca_from_pr"/>
            <field name="attachment"/>
            <!-- <field name="binding_model_id" ref="approval_extends.model_approval_expense"/> -->
            <!-- <field name="binding_type">report</field>      -->
        </record>

    </data>
</odoo>
