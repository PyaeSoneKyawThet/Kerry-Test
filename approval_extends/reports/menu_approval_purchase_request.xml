<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>         

        <record id="paperformat_custom_approval_purchase_request" model="report.paperformat">
            <field name="name">Approval Purchase Request</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">17</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">25</field>
            <field name="dpi">90</field>
        </record>

        <!-- QWeb Reports -->
        <record id="approval_purchase_request_report" model="ir.actions.report">
            <field name="name">Approval Purchase Request</field>
            <field name="model">approval.request</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">approval_extends.approval_purchase_request_print</field>
            <field name="report_file">approval_extends.approval_purchase_request_print</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="paperformat_id" ref="approval_extends.paperformat_custom_approval_purchase_request"/>
            <field name="attachment"/>       
            <!-- <field name="binding_model_id" ref="approval_extends.model_approval_request"/> -->
            <field name="binding_type">report</field>
        </record>
        

    </data>
</odoo>
