<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>         

        <record id="paperformat_custom_cash_advance_form" model="report.paperformat">
            <field name="name">Cash Advance Report Paperformat</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field> 
            <field name="margin_top">30</field>
            <field name="margin_bottom">17</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">25</field> 
            <field name="dpi">90</field>
        </record>

        <!-- QWeb Reports -->
        <record id="cash_advance_report" model="ir.actions.report">
            <field name="name">Cash Advance Print</field>
            <field name="model">cash.advance.form</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">approval_extends.cash_advance_print</field>
            <field name="report_file">approval_extends.cash_advance_print</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="paperformat_id" ref="approval_extends.paperformat_custom_cash_advance_form"/>
            <field name="attachment"/>     
            <field name="binding_model_id" ref="approval_extends.model_cash_advance_form"/>
            <field name="binding_type">report</field>
        </record>
        

    </data>
</odoo>
