<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <record id="view_account_payment_inherit_approval" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml"> 
            <xpath expr="//field[@name='ref']" position="after">
                <field name="is_cash_advance" invisible="1" readonly="1"/>
                <field name="diff_amount" invisible="1" readonly="0"/>
                <field name="request_id" invisible="partner_type != 'supplier'" readonly="state != 'draft'" force_save="1"/>
                <field name="purchase_order_no" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/> 
                <field name="vehicle_no" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="fmis_job_no" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="job_date" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="pay_to_id" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="pay_to_external" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="pay_to_bank_no" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
            </xpath> 
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="approval_payment_request_id" invisible="1" readonly="0"/>
                <field name="approval_expense_id" invisible="1" readonly="0"/>
                <field name="is_cash_advance" invisible="partner_type != 'supplier'" readonly="state != 'draft' or approval_expense_id or approval_payment_request_id"/>
                <field name="available_cash_advance_ids" widget="many2many_tags" invisible="1"/>
                <field name="cash_advance_id" invisible="partner_type != 'supplier'" 
                       readonly="state != 'draft' or not is_cash_advance" 
                       required="is_cash_advance" 
                       domain="[('id', 'in', available_cash_advance_ids)]" 
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="delivery_date" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="vendor_invoice_date" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="vendor_invoice_no" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="vendor_quotation_no" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="product_id" invisible="1"/>
                <field name="reason" readonly="state != 'draft'"/>
                <field name="bl_no" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="location" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="reference_key" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="brand_name" invisible="partner_type != 'supplier'" readonly="state != 'draft'"/>
                <field name="analytic_distribution" widget="analytic_distribution" readonly="state != 'draft'"
                groups="analytic.group_analytic_accounting" invisible="1"/>
            </xpath> 
            <xpath expr="//field[@name='account_payment_type_id']" position="before">
                <field name="is_cash_advance_cancel" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- tree view -->
    <record id="view_account_supplier_payment_tree_inherit_approval" model="ir.ui.view">
        <field name="name">account.supplier.payment.tree.inherit.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="arch" type="xml"> 
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="account_payment_type_id" optional="hide" />
                <field name="request_id" optional="hide" />
                <field name="purchase_order_no" optional="hide" />
                <field name="staff_location_id" optional="hide" />
                <field name="cash_advance_id" optional="hide" />
                <field name="vendor_invoice_no" optional="hide" />
                <field name="vendor_quotation_no" optional="hide" />
                <field name="vehicle_no" optional="hide"/>
                <field name="fmis_job_no" optional="hide"/>
                <field name="job_date" optional="hide"/>
                <field name="job_order_type" optional="hide"/>
                <field name="job_sub_service" optional="hide"/>
                <field name="pay_to_id" optional="hide"/>
                <field name="pay_to_external" optional="hide"/>
                <field name="pay_to_bank_no" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="vendor_invoice_date" optional="hide"/>
                <field name="reason" optional="hide"/>
                <field name="bl_no" optional="hide"/>
                <field name="location" optional="hide"/>
                <field name="reference_key" optional="hide"/>
                <field name="brand_name" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_supplier_payment_tree_inherit_kmtl" model="ir.ui.view">
        <field name="name">account.supplier.payment.tree.inherit.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="reason" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- search view -->
    <record id="view_account_payment_search_inherit_approval" model="ir.ui.view">
    <field name="name">account.payment.search.inherit</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_search"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='name']" position="before">
            <field name="request_id"/>
            <field name="purchase_order_no"/>
            <field name="cash_advance_id"/>
            <field name="vendor_invoice_no"/>
            <field name="account_payment_type_id" optional="hide" />
        </xpath>        
    </field>
    </record>
</odoo>