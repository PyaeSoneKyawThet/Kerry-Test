<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_process_config_form" model="ir.ui.view">
        <field name="name">approval.process.config.form</field>
        <field name="model">approval.process.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="approval_categ_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="from_amount"/>
                        <field name="to_amount"/>
                        <field name="currency_id"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="expense_range"/>
                        <field name="need_approval"/>
                        <field name="from_level"/>
                        <field name="to_level"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_approval_process_config_tree" model="ir.ui.view">
        <field name="name">approval.process.config.tree</field>
        <field name="model">approval.process.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="approval_categ_id"/>
                <field name="from_amount" optional="show"/>
                <field name="to_amount" optional="show"/>
                <field name="currency_id" optional="show"/>
                <field name="department_ids"  widget="many2many_tags" optional="show"/>
                <field name="expense_range" optional="show"/>
                <field name="need_approval" optional="show"/>
                <field name="from_level" optional="show"/>
                <field name="to_level" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="approval_process_config_search_view" model="ir.ui.view">
        <field name="name">approval.process.config.search</field>
        <field name="model">approval.process.config</field>
        <field name="arch" type="xml">
            <search string="Approval Process Config">
                <group expand="1" string="Group By">
                    <filter string="Approval Types" name="group_by_approval_categ_id" context="{'group_by':'approval_categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_approval_process_config" model="ir.actions.act_window">
        <field name="name">Approval Process Config</field>
        <field name="res_model">approval.process.config</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="approval_extends.view_approval_process_config_tree"/>
        <field name="domain">[]</field>
        <field name="context">{'search_default_group_by_approval_categ_id': 1}</field>
        <field name="target">current</field>
    </record>


    <menuitem id="menu_approval_process_config" name="Approval Process Config" parent="approvals.approvals_menu_config" action="action_approval_process_config" sequence="2"/>
</odoo>