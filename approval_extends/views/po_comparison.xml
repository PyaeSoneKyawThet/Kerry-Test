<odoo>

    <record id="action_po_comparison" model="ir.actions.act_window">
        <field name="name">PO Comparison</field>
        <field name="res_model">po.comparison</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Approvals Requests
            </p>
            <p>
                Let's go to the <a type="action" class="text-primary" name="%(approvals.approval_category_action_new_request)d">new request</a> menu
            </p>
        </field>
    </record>

    <record id="view_po_comparison_list" model="ir.ui.view">
        <field name="name">po.comparison.list</field>
        <field name="model">po.comparison</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="request_owner_id"/>
                <field name="department_id"/>
                <field name="date"/>   
                <field name="est_delivery_date" optional="hide"/>  
                <field name="date_confirmed" optional="hide"/>  
                <field name="category_id" optional="hide"/>
                <field name="currency_id"/>    
                <field name="staff_location_id" optional="hide"/>   
                <field name="pr_line_ids" widget="many2many_tags" optional="hide"/>    
                <field name="pay_to_id" optional="hide"/>
                <field name="pay_to_external" optional="hide"/>   
                <field name="remark" string="Remark" optional="hide"/>               
                <field name="state" decoration-muted="state == 'draft'"  decoration-success="state == 'confirm'" decoration-danger="state == 'cancel'" widget="badge"/>               
            </tree>
        </field>
    </record>
 
    <record id="view_po_comparison_form" model="ir.ui.view">
        <field name="name">po.comparison.form</field>
        <field name="model">po.comparison</field>
        <field name="arch" type="xml">
            <form editable="bottom">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                        invisible="state != 'draft'" data-hotkey="q"/>
                    <button name="action_cancel" string="Cancel" type="object" class="oe_highlight"
                        invisible="state == 'cancel'" data-hotkey="q" />
                    <button name="action_draft" string="Back To Draft" type="object" 
                        invisible="state != 'cancel'" data-hotkey="w"/>
                    <button name="action_create_new_quotation" string="New Quotation" type="object" class="btn-primary" data-hotkey="v" invisible="state not in ('confirm')"/>
                    <field name="state" widget="statusbar" />
                    <button name="action_print_comparison_report" 
                        string="Comparison Report" 
                        type="object" 
                        class="oe_highlight"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_approval_create_rfq" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="create_rfq_count == 0">
                            <field name="create_rfq_count" widget="statinfo" string="RFQs/Orders"/>
                        </button> 
                    </div> 
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_owner_id" readonly="state in ('confirm')"/>
                            <field name="department_id" readonly="state in ('confirm')" required="1"/>
                            <field name="category_id" domain="[('approval_type', '=', 'po_comparison')]" readonly="state in ('confirm')"/>
                            <field name="currency_id" readonly="state in ('confirm')" required="1"/>
                            <field name="staff_location_id" readonly="state in ('confirm')" required="1"/>                          
                        </group>
                        <group>
                            <field name="date" readonly="state in ('confirm')"/>
                            <field name="est_delivery_date" readonly="state in ('confirm')"/>
                            <field name="date_confirmed" readonly="1"/>
                            <field name="pay_to_id" readonly="state in ('confirm')"/> 
                            <field name="pay_to_external" readonly="state in ('confirm')"/>                             
                            <label for="pr_line_ids" string="PR No"/>
                            <div class="o_row">                            
                                <field name="pr_line_ids" readonly="state in ('confirm')" widget="many2many_tags" nolabel="1"
                                options="{'no_create': True, 'no_create_edit': True}" domain="[('approval_type', '=', 'purchase_req'), ('without_PO', '!=', True), ('request_status', '=', 'approved'), ('pr_done', '!=', True)]"/>
                                <button name="action_generate_lines" type="object" string="Generate Lines" class="btn-primary"
                                invisible="state in ('confirm')"/>
                            </div>
                        </group>                     
                    </group>
                    <notebook>
                        <page string="Details">
                            <field name="po_comparison_line_ids" mode="tree,kanban" readonly="state in ('confirm')">
                                <tree editable="bottom" >
                                    <field name="department_id" column_invisible="1"/>
                                    <field name="purchase_request_line_id" widget="many2one_barcode" options="{'no_create': True, 'no_create_edit': True}" required="1"
                                    string="PR No" domain="[('approval_type', '=', 'purchase_req'), ('without_PO', '!=', True), ('request_status', '=', 'approved'), ('pr_done', '!=', True)]"/>
                                    <field name="product_id" required="1" domain="[('purchase_ok', '=', True)]"/>
                                    <field name="description"/>
                                    <field name="brand_id"/>
                                    <field name="fmis_job_no"/>
                                    <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting"/>
                                    <field name="vehicle_no"/>
                                    <field name="bl_no"/>
                                    <field name="reference_key"/>
                                    <field name="quantity" required="1"/>
                                    <field name="unit_price" />
                                    <field name="product_uom_id" required="1"/>
                                    <field name="total_amount"/>
                                </tree>
                            </field>
                        </page>
                        <page name="remark" string="Comparison Remark">
                            <field name="remark" readonly="state in ('confirm')"/>
                        </page>
                    </notebook>
                </sheet>      
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>        
            </form>
        </field>
    </record>

    <!--search view -->
    <record id="po_comparison_search_view" model="ir.ui.view">
        <field name="name">po.comparison.view.search</field>
        <field name="model">po.comparison</field>
        <field name="arch" type="xml">
            <search string="PO Comparison">
                <field name="name"/>
                <field name="department_id" filter_domain="[('department_id', 'child_of', raw_value)]"/>
                <field name="request_owner_id"/>
                <field name="staff_location_id"/>
                <field name="pr_line_ids"/>
            </search>
        </field>
    </record>

</odoo>
