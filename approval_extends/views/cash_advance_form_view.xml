<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_cancel_cash_advance" model="ir.actions.server">
        <field name="name">Cancel Cash Advance</field>
        <field name="model_id" ref="model_cash_advance_form"/>
        <field name="binding_model_id" ref="model_cash_advance_form"/>
        <field name="binding_type">action</field> 
        <field name="state">code</field>
        <field name="code">
            action = records.action_cancel()
        </field>
    </record>
    <!-- search view -->
    <record id="cash_advance_search_view" model="ir.ui.view">
        <field name="name">cash_advance.view.search</field>
        <field name="model">cash.advance.form</field>
        <field name="arch" type="xml">
            <search string="Cash Advance">
                <field name="name"/>
                <field name="request_owner_id"/>
                <field name="partner_id"/>
                <field name="request_id"/>
                <field name="vendor_quotation_no"/>
                <field name="vendor_invoice_no"/>
                <field name="department_id" filter_domain="[('department_id', 'child_of', raw_value)]"/>
            </search>
        </field>
    </record>

    <!-- tree view -->
    <record id="cash_advance_form_tree_view" model="ir.ui.view"> 
        <field name="name">Cash Advance Tree View</field>
        <field name="model">cash.advance.form</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="request_owner_id" />
                <field name="department_id" />
                <field name="partner_id" optional="show"/>
                <field name="request_id" optional="show"/> 
                <field name="date" optional="show"/>
                <field name="is_clear" optional="show"/> 
                <field name="amount" optional="show"/> 
                <field name="bl_no" optional="show"/>
                <field name="reference_key" optional="show"/> 
                <field name="tax_amount" optional="show"/>
                <field name="total_amount" optional="show"/> 
                <field name="vendor_quotation_no" optional="hide"/> 
                <field name="vendor_invoice_no" optional="hide"/> 
                <field name="request_status" decoration-info="request_status == 'new'" decoration-warning="request_status == 'pending'" decoration-success="request_status == 'approved'" decoration-danger="request_status == 'refused'" widget="badge"/>
                <field name="purchase_request_status" optional="show" decoration-info="purchase_request_status == 'new'" decoration-warning="purchase_request_status == 'pending'" decoration-success="purchase_request_status == 'approved'" decoration-danger="purchase_request_status == 'refused'" widget="badge"/>
                <field name="payment_approved_ids" widget="many2many_tags" optional="show"/> 
                <field name="account_payment_state" optional="show" decoration-info="account_payment_state == 'draft'" 
                    decoration-success="account_payment_state in ['posted']" decoration-danger="account_payment_state in ['cancel']" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- form view -->
    <record id="cash_advance_form_view" model="ir.ui.view">
        <field name="name">Cash Advance Form</field>
        <field name="model">cash.advance.form</field> 
        <field name="arch" type="xml">
            <form string="Cash Advance Form">
                <header>
                    <field name="user_status" invisible="1"/>
                    <field name="has_access_to_request" invisible="1"/>
                    <field name="is_locked" invisible="1"/>
                    <button name="action_confirm" type="object" string="Submit" class="oe_highlight" invisible="request_status != 'new'"/>
                    <button name="action_check" string="Check" type="object" invisible="request_status in ['checked', 'approved', 'refused', 'cancel'] or user_status != 'to_check'" class="btn-primary" data-hotkey="v"/>
                    <button name="action_approve" string="Approve" type="object" invisible="request_status in ['approved', 'refused', 'cancel'] or user_status != 'pending'" class="btn-primary" data-hotkey="v"/>
                    <button name="action_refuse" string="Refuse" type="object" invisible="request_status in ['approved', 'refused', 'cancel'] or user_status not in ['to_check', 'pending']" data-hotkey="z"/>
                    <button name="action_draft" string="Back To Draft" type="object" invisible="request_status != 'cancel'" data-hotkey="w"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="is_locked or request_status in ['cancel']" data-hotkey="x"/>
                    <button name="action_lock" string="Locked" type="object" invisible="request_status != 'approved' or is_locked" data-hotkey="l"/>
                    <button name="action_unlock" string="UnLocked" type="object" invisible="request_status != 'approved' or not is_locked" data-hotkey="u"/>
                    <button name="action_reimburse" string="Reimburse" type="object" class="oe_highlight" invisible="is_clear or not able_to_reimburse or not is_reimburse"/>
                    <field name="request_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment" string="Payments" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group> 
                        <group> 
                            <field name="approval_type" invisible="1"/>
                            <field name="category_id" domain="[('approval_type', '=', approval_type)]" readonly="1"/>
                            <field name="request_owner_id" required="1" readonly="request_status in('pending','checked','approved')" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" />
                            <field name="pay_to_id" readonly="request_status in('pending','checked','approved')" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" />
                            <field name="pay_to_external" required="0" readonly="request_status in('pending','checked','approved')" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" />
                            <field name="employee_id" invisible="1"/>
                            <field name="department_id"/>
                            <field name="request_id" domain="[('id', '=', request_id)]" options="{'no_create': True, 'no_create_edit': True}" readonly="request_status in('pending','checked','approved')"/>
                            <field name="purchase_order_id" readonly="request_status in('pending','checked','approved')"
                            options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="vehicle_no" readonly="request_status in('pending','checked','approved')"/>
                            <field name="fmis_job_no" readonly="request_status in('pending','checked','approved')"/>
                            <field name="job_date" readonly="request_status in('pending','checked','approved')"/>
                            <field name="location" readonly="request_status in('pending','checked','approved')" />
                            <field name="staff_location_id" readonly="request_status in('pending','checked','approved')"/>
                            <field name="product_id" readonly="request_status in('pending','checked','approved')" required="1" domain="[('purchase_ok', '=', True)]"/>
                            <field name="description" readonly="request_status in('pending','checked','approved')" />
                            <field name="payment_id" invisible="1"/>
                             <field name="payment_ids" invisible="1" widget="many2many_tags"/>
                            <field name="company_id" invisible="1"/>
                            <field name="is_clear" readonly="1"/>
                            <field name="is_reimburse" readonly="not able_to_reimburse or is_clear"/>
                        </group>
                        <group>
                            <field name="config_id" invisible="1"/>
                            <field name="able_to_reimburse" invisible="1"/>
                            <field name="is_cash_advance_cancel" readonly="1"/>
                            <field name="is_request_cancel" readonly="1"/>
                            <field name="partner_id" options="{'no_create': True, 'no_create_edit': True}" readonly="request_status in('pending','checked','approved')"/>
                            <field name="vendor_quotation_no" readonly="request_status in('pending','checked','approved')"/>
                            <field name="vendor_invoice_no" readonly="request_status in('pending','checked','approved')"/>
                            <field name="date" required="1" readonly="request_status in('pending','checked','approved')" />
                            <field name="est_delivery_date" readonly="request_status in('pending','checked','approved')" />
                            <field name="date_confirmed" groups="base.group_no_one" readonly="1"/>
                            <field name="payment_type_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="available_journal_ids" widget="many2many_tags" invisible="1"/>
                            <!-- <field name="journal_id" required="1" readonly="request_status in('pending','checked','approved')" 
                            options="{'no_create': True, 'no_create_edit': True}" domain="[('id', 'in', available_journal_ids)]"/> -->
                            <field name="currency_id" required="1" options="{'no_create': True, 'no_create_edit': True}" readonly="request_status in('pending','checked','approved')"/>
                            <field name="amount" readonly="request_status in('pending','checked','approved')"/>
                            <!-- <field name="tax_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}" readonly="request_status in('pending','checked','approved')"/>
                            <field name="tax_amount" readonly="request_status in('pending','checked','approved')"/>
                            <field name="total_amount" readonly="request_status in('pending','checked','approved')"/> -->
                            <field name="bl_no" readonly="request_status in('pending','checked','approved')"/>
                            <field name="reference_key" readonly="request_status in('pending','checked','approved')"/>
                            <field name="brand_id" readonly="request_status in('pending','checked','approved')" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>  
                            <field name="analytic_distribution" widget="analytic_distribution" invisible="1"
                                groups="analytic.group_analytic_accounting" readonly="request_status in('pending','checked','approved')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Account Description">
                            <field name="reason" readonly="request_status in('pending','checked','approved')"/>
                        </page>
                        <page string="Approvers">
                            <field name="approver_ids" mode="tree,kanban" readonly="1">
                                <tree editable="bottom" decoration-success="status in ['checked', 'approved']" decoration-warning="status in ['pending', 'waiting', 'to_check']" decoration-danger="status=='refused'" no_open="1">
                                    <field name="existing_request_user_ids" column_invisible="True"/>
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="can_edit" column_invisible="True"/>
                                    <field name="can_edit_user_id" column_invisible="True"/>
                                    <field name="user_ids" string="Approvers" widget="many2many_tags" readonly="1" options="{'no_create': True}" 
                                           required="1"/>
                                    <field name="user_id" string="Approver" readonly="1" force_save="1" column_invisible="1"/>
                                    <field name="required" readonly="not can_edit" force_save="1"/>
                                    <field name="level"/>
                                    <field name="status"/>
                                    <field name="company_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cash_advance" model="ir.actions.act_window">
        <field name="name">Approval Cash Advance</field>
        <field name="res_model">cash.advance.form</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Cash Advance Requests
            </p>
            <p>
                Let's go to the <a type="action" class="text-primary" name="%(approvals.approval_category_action_new_request)d">new request</a> menu
            </p>
        </field>
    </record>

    <menuitem id="menu_cash_advance" 
              name="Approval Cash Advance" 
              parent="approvals.approvals_menu_manager"
              action="approval_extends.action_cash_advance"
              sequence="50"/>


</odoo>