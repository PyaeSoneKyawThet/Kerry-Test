<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <record id="view_acc_move_tree_inherit_approvals" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.approvals</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="staff_location_id" optional="hide"/>
                <field name="cash_advance_id" optional="hide"/>
                <field name="account_payment_type_id" string="Type" optional="hide"/>
                <field name="brand_name" optional="hide"/>
                <field name="approval_request_id" optional="hide"/>
                <field name="purchase_order_no" optional="hide"/>
                <field name="pay_to_id" optional="hide"/>
                <field name="pay_to_external" optional="hide"/>
                <field name="vendor_quotation_no" optional="hide"/>
                <field name="vendor_invoice_no" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="invoice_date" optional="hide"/>
                <field name="reference_key" optional="hide"/>
                <field name="location" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='analytic_distribution']" position="after">
                <field name="reason" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_reconcile_tree_inherit_approval" model="ir.ui.view">
        <field name="name">view.move.line.reconcile.tree</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account_accountant.view_move_line_reconcile_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_name']" position="after">
                <field name="approval_request_id" optional="show"/>
            </xpath>
        </field>
    </record>

        <!-- search view -->
    <record id="view_account_move_line_reconcile_search_inherit" model="ir.ui.view">
        <field name="name">account.move.line.reconcile.search.inherit</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account_accountant.view_account_move_line_reconcile_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="approval_request_id"/>
                <field name="cash_advance_id"/>
            </xpath>        
        </field>
    </record>
</odoo>