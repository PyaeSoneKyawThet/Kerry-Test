<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="custom_header_footer_payment_voucher">
            <t t-foreach="docs" t-as="doc">
                <div class="header">
                    <div style="report_header_style">
                        <div class="row justify-content-end">
                            <div class="col-3"></div>
                            <div class="col-6 py-4">
                                <div style="font-weight:bold;">
                                    <h4 class="text-center">  
                                        <span>PAYMENT VOUCHER</span> 
                                    </h4>
                                </div>
                            </div>
                            <div class="col-3 text-end">
                                <span t-field="doc.company_id.logo"
                                    t-options="{'widget':'image', 'style': 'height:85px; width:130px'}" />
                            </div>
                        </div>
                        
                    </div>
                </div>

                <div class="footer" style="margin-bottom: -300px  !important;border-top: 1px solid black">                              
                    <div class="row">
                        <div class="col-4">
                            <span style="font-size: 15px;" t-if="doc.company_id.name" t-field="doc.company_id.name"></span>
                        </div>
                        <div class="col-4 text-center">
                            <span style="font-size: 12px;">
                                <span t-field="doc.name"/>
                            </span>
                        </div>
                        <div class="col-4 text-end" style="height: 25px;">                        
                            <p style="font-size: 12px;"><small>
                                Page: <span class="page"/> / <span class="topage"/>
                                <span class="ms-2" t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M:%S')"/>
                            </small></p>                                               
                        </div> 
                    </div>                       
                </div>
            </t>
        </template>

        <template id="custom_vendor_payment_report">
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
                <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat" /> <!-- So that it
                appears in the footer of the report instead of the company VAT if it's set -->

                <div class="page" style="font-size: 11px;">
                    <!-- <div class="row mb-4">
                        <div class="col-6">
                            <span>Payment Voucher No:</span>
                            <span t-field="doc.name" />
                        </div>
                    </div> -->

                    <div class="row">
                        <div class="col-6" name="Information 1">
                            <div class="row mb-1">
                                <div class="col-5">
                                    <strong>Payment Voucher No</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-6" t-if="doc.name">
                                    <span t-field="doc.name" />
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-5">
                                    <strong>Vendor Name</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-6" t-if="doc.partner_id.name">
                                    <span t-field="doc.partner_id.name" />
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-5">
                                    <strong>PV/GL Date</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-6" t-if="doc.date">
                                    <span t-field="doc.date" />
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-5">
                                    <strong>Bank Name</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-6" t-if="doc.journal_id">
                                    <span t-field="doc.journal_id" />
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-5">
                                    <strong>Exchange Rate</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-6"  t-if="doc.currency_rate">
                                    <span t-field="doc.currency_rate" t-options="{'widget': 'float', 'precision': 4, 'thousand_separator': True}"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-6" name="Information 2">
                            <div class="row mb-1">
                                <div class="col-4">
                                    <strong>Bank Transfer No</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" >
                                    <span t-field="doc.cheque_no" />
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-4 ">
                                    <strong>Pay To</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" >
                                    <t t-if="doc.pay_to_id"><span t-field="doc.pay_to_id"/></t>
                                    <t t-if="doc.pay_to_id and doc.pay_to_external"><span>,</span></t>
                                    <t t-if="doc.pay_to_external"><span t-field="doc.pay_to_external"/></t>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-4">
                                    <strong>Currency</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.report_currency_id">
                                    <span t-field="doc.report_currency_id.name" />
                                </div>
                            </div>
                            
                            <div class="row mb-1">
                                <div class="col-4">
                                    <strong>Payment Amount</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.report_amount">
                                    <span t-field="doc.report_amount" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                </div>
                            </div>
                        </div>
                    </div>

