                    <table class="table table-borderless border-0 mt-2"  style="margin-bottom: 25px;">
                        <tr class="border border-dark border-1 border-start-0 border-end-0 ">
                            <th class="border-0 text-start" style="text-transform: capitalize;width:15%;">Account Code</th>
                            <th class="border-0" style="text-transform: capitalize;width:30%;">Account Name</th>
                            <th class="border-0 text-end" style="text-transform: capitalize;width:20%;">Amount</th>
                            <th class="border-0 text-end" style="text-transform: capitalize;width:15%;">Debit (MMK)</th>
                            <th class="border-0 text-end" style="text-transform: capitalize;width:20%;">Credit (MMK)</th>
                        </tr>
                        <tbody>
                            <t t-set="total_credit" t-value="0" />
                            <t t-set="total_debit" t-value="0" />
                            
                            <t t-foreach="doc.move_id.line_ids" t-as="line">
                                <tr class="border-0 border-top-0">
                                    <td class="border-0 text-start" name="td_account_code" style="width: 15%;">
                                        <span t-field="line.account_id.code"/>
                                    </td>
                                    <td class="border-0" name="td_account_name" style="width: 30%;">
                                        <span t-field="line.account_id.name"/>
                                    </td>
                                    <td name="td_amount_currency" class="text-end border-0" style="width:20%;">
                                        <span t-out="line.amount_currency" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td name="td_debit" class="text-end border-0" style="width:15%;">
                                        <span t-field="line.debit" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                        <!-- <span t-field="line.debit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id, 'precision': 2}"/> -->
                                    </td>
                                    <t t-set="total_debit" t-value="total_debit + line.debit"></t>
                                    <td name="td_credit" class="text-end border-0" style="background-color: #ffffff;width:20%;color: #555555;">
                                        <span t-field="line.credit" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                        <!-- <span t-field="line.credit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id, 'precision': 2}"/> -->
                                    </td>
                                    <t t-set="total_credit" t-value="total_credit + line.credit"></t>
                                </tr>
                            </t>

                            <!-- check if the current payment is the last payment -->
                            <t t-set="has_write_off" t-value="False"/> 
                            <t t-foreach="doc.reconciled_bill_ids" t-as="line">
                                <t t-if="line.report_invoice_payments_widget">
                                    <t t-set="payment_data" t-value="json.loads(line.report_invoice_payments_widget)" />
                                    <t t-if="payment_data.get('content')">
                                        <t t-set="payment_amount" t-value="0" />
                                        <t t-set="payment_list" t-value="[payment for payment in payment_data['content'] if payment['invoice_id'] == line.id and not payment['is_exchange'] and payment['account_payment_id']]" />
                                        <t t-if="payment_list">
                                            <t t-set="last_payment" t-value="sorted(payment_list, key=lambda p: p['index_no'])[-1]" />
                                            <t t-foreach="payment_list" t-as="payment">
                                                <t t-if="payment['account_payment_id'] == doc.id">
                                                    <t t-if="payment['account_payment_id'] == last_payment['account_payment_id']">
                                                        <t t-set="has_write_off" t-value="True"/> 
                                                    </t>
                                                </t>
                                            </t>
                                        </t>
                                    </t>
                                </t>
                            </t>

                            <!-- write off and exchange difference rows
                             ( eg: invoice used:5000, paymnet:3000, write-off:2000 )
                            -->
                            <t t-foreach="doc.reconciled_bill_ids" t-as="line">
                                <t t-set="write_off_line" t-value="line._get_write_off_journal(doc.id)">  </t>
                                <t t-if="has_write_off and write_off_line['write_off_moves']">
                                    <t t-foreach="write_off_line['write_off_moves'].invoice_line_ids" t-as="line">
                                        <tr class="border-0">
                                            <td class="border-0 text-end" t-esc="index"></td>
                                            <td class="border-0" name="td_account_code">
                                                <span t-field="line.account_id.code"/>
                                            </td>
                                            <td class="border-0" name="td_account_name" style="width: 30%;">
                                                <span t-field="line.account_id.name"/>
                                            </td>
                                            <td name="td_amount_currency" class="text-end border-0">
                                                <span t-out="line.amount_currency" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                            </td>
                                            <td name="td_debit" class="text-end border-0">
                                                <span t-field="line.debit" t-options="{'widget': 'float',  'precision': 2, 'thousand_separator': True}"/>
                                            </td>
                                            <t t-set="total_debit" t-value="total_debit + line.debit"></t>
                                            <td name="td_credit" class="text-end border-0" style="background-color: #ffffff;color: #555555;">
                                                <span t-field="line.credit" t-options="{'widget': 'float',  'precision': 2, 'thousand_separator': True}"/>
                                            </td>
                                            <t t-set="total_credit" t-value="total_credit + line.credit"></t>
                                        </tr>
                                        <!-- <t t-set="index" t-value="index + 1"/>  -->
                                    </t>
                                </t>    
                            </t>

                            <!-- write off created for extra payment amount 
                             ( eg: invoice used:3000, paymnet:5000, write-off:2000 )
                            -->
                            <t t-if="has_write_off">
                                <t t-set="extra_write_off_lines" t-value="doc._get_write_off_journal()" />
                                <t t-if="extra_write_off_lines">
                                    <t t-foreach="extra_write_off_lines" t-as="line">
                                        <tr class="border-0">
                                            <td class="border-0 text-end" t-esc="index"></td>
                                            <td class="border-0" name="td_account_code">
                                                <span t-field="line.account_id.code"/>
                                            </td>
                                            <td class="border-0" name="td_account_name" style="width: 30%;">
                                                <span t-field="line.account_id.name"/>
                                            </td>
                                            <td name="td_amount_currency" class="text-end border-0">
                                                <span t-out="line.amount_currency" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                            </td>
                                            <td name="td_debit" class="text-end border-0">
                                                <span t-out="'-{:,.2f}'.format(line.debit) if line.debit != 0 else '{:,.2f}'.format(line.debit)"/>
                                            </td>
                                            <t t-set="total_debit" t-value="total_debit - line.debit"></t>
                                            <td name="td_credit" class="text-end border-0" style="background-color: #ffffff;">
                                                <span t-out="'-{:,.2f}'.format(line.credit) if line.credit != 0 else '{:,.2f}'.format(line.credit)"/>
                                            </td>
                                            <t t-set="total_credit" t-value="total_credit - line.credit"></t>
                                        </tr>
                                    </t>
                                </t> 
                            </t>

                            <tr name="Total Row" class="border border-dark border-1 border-start-0 border-end-0" >
                                <td class="border-0"></td>
                                <td class="border-0">
                                    <span>Total Amount</span>
                                </td>
                                <td class="border-0"></td>
                                <td class="text-end border-0">
                                    <span t-esc="total_debit" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                </td>
                                <td class="text-end border-0" style="background-color: #ffffff;color: #555555;">
                                    <span t-esc="total_credit" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <t t-if="any(line.report_invoice_payments_widget for line in doc.reconciled_bill_ids)">

                        <t t-set="refund_values" t-value="doc._get_credit_refund_value()"/>
                    
                        <t t-foreach="doc._get_grouped_bill()" t-as="group">
                            <p style="font-size: 15px;">Applied Invoice(<span t-out="group['currency'].name"/>)</p>
                            <!-- bill table -->
                            <table class="table table-borderless border-0" style="margin-bottom: 30px;">
                                <tr class="border border-dark border-1 border-start-0 border-end-0 ">
                                    <th class="border-0 text-center" style="text-transform: capitalize;">Vendor Invoice No</th>
                                    <th class="border-0 text-center" style="text-transform: capitalize;">AP Invoice No</th>
                                    <th class="border-0 text-center" style="text-transform: capitalize;">Description</th>
                                    <th class="border-0 text-center" style="text-transform: capitalize;">Invoice Date</th>
                                    <th class="border-0 text-center" style="text-transform: capitalize;">Base Amount</th>
                                    <th class="border-0 text-center" style="text-transform: capitalize;">CT Amount</th>
                                    <th class="border-0 text-center" style="text-transform: capitalize;">Invoice Amount</th>
                                    <th class="border-0 text-center" style="text-transform: capitalize;">Account Balance</th>
                                    <th class="border-0 text-center" style="text-transform: capitalize;">WHT Amount</th>
                                    <th class="border-0 text-center" style="text-transform: capitalize;">Pay Amount</th>
                                </tr>
                                <tbody>
                                    <t t-set="total_base_amount" t-value="0" />
                                    <t t-set="total_tax_amount" t-value="0" />
                                    <t t-set="total_write_off_amount" t-value="0" />

                                    <t t-set="total_invoice_amount" t-value="0" />
                                    <t t-set="total_this_payment" t-value="0" />
                                    <t t-set="total_balance_due" t-value="0" />
                                    <t t-set="total_amount_balance" t-value="0" />

                                    <t t-set="balance_due" t-value="0" />
                                    <t t-set="amount_balance" t-value="0" />
                                    <t t-set="payment_amount" t-value="0" />
                                    <t t-set="index_no" t-value="1" />
                                    <t t-set="stop_summing" t-value="False" />
                                    <t t-set="write_off_amount" t-value="0" />
                                    <t t-set="refund_amount" t-value="0" />

                                    <t t-foreach="group['bills']" t-as="line">
                                        <t t-if="line.report_invoice_payments_widget">
                                            <t t-set="show_write_off_value" t-value="line._is_show_wirte_off_value()"/>
                                            <t t-set="payment_data" t-value="json.loads(line.report_invoice_payments_widget)" />
                                            <t t-if="payment_data.get('content')">

                                                <t t-set="payment_amount" t-value="0" />
                                                <t t-foreach="payment_data['content']" t-as="payment">
                                                    <t t-if="payment['invoice_id'] == line.id and payment['account_payment_id'] != doc.id and payment['account_payment_id'] and not stop_summing">
                                                        <t t-set="payment_amount" t-value="payment_amount + payment['amount']" /> <!-- payment_amount = amount paid for invoice before current payment -->
                                                    </t>

                                                    <t t-if="payment['invoice_id'] == line.id and not payment['is_exchange'] and payment['account_payment_id']">
                                                        <t t-if="payment['account_payment_id'] == doc.id">
                                                            <t t-set="amount" t-value="payment['amount']"/> <!-- amount = amount paid for invoice from current payment -->
                                                            <t t-set="stop_summing" t-value="True"/>
                                                        </t>
                                                    </t>

                                                    <t t-if="payment['invoice_id'] == line.id and not payment['is_exchange'] and 
                                                            not payment['account_payment_id'] and 
                                                            has_write_off and payment['move_type'] != 'in_refund' and show_write_off_value">
                                                        <t t-set="write_off_amount" t-value="write_off_amount + payment['amount']" /> <!-- write_off_amount = write off amount if write-off is created after current payment -->
                                                    </t>

                                                    <t t-if="payment['invoice_id'] == line.id and not payment['is_exchange'] and 
                                                            not payment['account_payment_id']
                                                            and payment['move_type'] == 'in_refund'">
                                                        <t t-set="refund_amount" t-value="refund_amount + payment['amount']" /> <!-- refund_amount = refund amount if credit note is created before current payment -->
                                                    </t>
                                                </t>
                                                

                                                <t t-set="amount_balance" t-value="line.tax_totals['amount_total'] - (payment_amount + refund_amount)" /> <!-- amount_balance = amount that remain on invoice before current payment -->
                                                <t t-set="amount" t-value="amount"/>
                                                <t t-set="refund_amount" t-value="0"/>
                                            </t>
                                        </t>

                                        <t t-set="refund_total" t-value="refund_values.get(line.id, {}).get('total', 0.0)"/>

                                        <tr class="border-0" style="background-color: #ffffff;"> <!-- Enforced white background -->
                                            <td class="border-0 text-left" name="td_invoice_name">
                                                <span t-field="line.vendor_invoice_no" />
                                            </td>
                                            <td class="border-0 text-center" name="td_ap_invoice_name">
                                                <span t-field="line.name" />
                                            </td>
                                            <td class="border-0 text-left" name="td_description">
                                                <span t-field="line.reason" />
                                            </td>
                                            <td class="border-0 text-center" name="td_invoice_date">
                                                <span t-field="line.invoice_date" />
                                            </td>
                                            <td class="border-0 text-center" name="td_base_amount">
                                                <span t-field="line.amount_untaxed" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                                <t t-set="total_base_amount" t-value="total_base_amount + line.amount_untaxed" />
                                            </td>
                                            <td class="border-0 text-center" name="td_tax_amount">
                                                <span t-field="line.amount_tax" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                                <t t-set="total_tax_amount" t-value="total_tax_amount + line.amount_tax" />
                                            </td>
                                            <td class="border-0 text-center" name="td_invoice_amount">
                                                <span t-field="line.amount_total" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                                <t t-set="total_invoice_amount" t-value="total_invoice_amount + line.amount_total" />
                                            </td>
                                            <td class="text-end border-0" name="td_amount_balance">
                                                <span t-out="amount_balance + refund_total"  t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                            </td>
                                            <t t-set="total_amount_balance" t-value="total_amount_balance + amount_balance + refund_total" />
        
                                            <td class="text-end border-0" name="td_write_off_amount">
                                                <span t-esc="write_off_amount" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                            </td>
                                            <t t-set="total_write_off_amount" t-value="total_write_off_amount + write_off_amount" />
        
                                            <td class="text-end border-0" name="td_this_payment" style="background-color: #ffffff;color: #555555;">
                                                <span t-esc="amount" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                            </td>
                                            <t t-set="total_this_payment" t-value="total_this_payment + amount" />
                                        </tr>
                                        

                                        <!-- refund will display here -->
                                        <t t-foreach="refund_values.get(line.id, {}).get('lines', [])" t-as="refund">
                                            <tr class="border-0" style="background-color: #ffffff;"> <!-- Enforced white background -->
                                                <td class="border-0 text-left" name="td_invoice_name">
                                                    <span t-out="refund['vendor_invoice_no']" />
                                                </td>
                                                <td class="border-0 text-center" name="td_ap_invoice_name">
                                                    <span t-out="refund['name']" />
                                                </td>
                                                <td class="border-0 text-left" name="td_description">
                                                    <span t-out="refund['reason']" />
                                                </td>
                                                <td class="border-0 text-center" name="td_invoice_date">
                                                    <span t-out="refund['date']" />
                                                </td>
                                                <td class="border-0 text-center" name="td_base_amount">
                                                    <span t-out="refund['amount_untaxed']" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                                    <t t-set="total_base_amount" t-value="total_base_amount + refund['amount_untaxed']" />
                                                </td>
                                                <td class="border-0 text-center" name="td_tax_amount">
                                                    <span t-out="refund['amount_tax']" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                                    <t t-set="total_tax_amount" t-value="total_tax_amount + refund['amount_tax']" />
                                                </td>
                                                <td class="border-0 text-center" name="td_invoice_amount">
                                                    <span t-out="refund['amount_total']" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                                    <t t-set="total_invoice_amount" t-value="total_invoice_amount + refund['amount_total']" />
                                                </td>
                                                <td class="text-end border-0" name="td_amount_balance">
                                                    <span t-out="refund['amount_total']"  t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                                </td>
                                                <t t-set="total_amount_balance" t-value="total_amount_balance + refund['amount_total']" />
            
                                                <td class="text-end border-0" name="td_write_off_amount">
                                                </td>
            
                                                <td class="text-end border-0" name="td_this_payment" style="background-color: #ffffff;color: #555555;">
                                                </td>
                                            </tr>
                                        </t>

                                        <t t-set="write_off_amount" t-value="0"/>
                                    </t>


                                    <tr><td colspan="5" class="border-0" style="height: 5px;background-color: #ffffff;"></td></tr>
                                    <tr name="Total Row" class="border border-dark border-1 border-start-0 border-end-0" style="background-color: #ffffff;"> <!-- Total row BG to white -->
                                        <td class="border-0 text-center" colspan="4" style="background-color: #ffffff;" >
                                            <span>Total Amount</span>
                                        </td>
                                        <td class="text-end border-0" style="background-color: #ffffff;">
                                            <span t-esc="total_base_amount" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}" />
                                        </td>
                                        <td class="text-end border-0" style="background-color: #ffffff;">
                                            <span t-esc="total_tax_amount" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}" />
                                        </td>
                                        <td class="text-end border-0" style="background-color: #ffffff;">
                                            <span t-esc="total_invoice_amount" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}" />
                                        </td>
                                        <td class="text-end border-0" style="background-color: #ffffff;">
                                            <span t-esc="total_amount_balance" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}" />
                                        </td>
                                        <td class="text-end border-0" style="background-color: #ffffff;">
                                            <span t-esc="total_write_off_amount" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}" />
                                        </td>
                                        <td class="text-end border-0" style="background-color: #ffffff;color: #555555;">
                                            <span t-esc="total_this_payment" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table> 
                        </t>

                    </t>
                    <br/><br/>
                    <p style="font-size: 15px;">Remark<span style="margin-left:5px;margin-right:5px;">:</span><span t-field="doc.ref"></span></p>  

                    <t t-set="checker" t-value="doc.vendor_payment_approver_ids.filtered(lambda l: l.status == 'checked').sorted(key=lambda l: l.id)[-1] if doc.vendor_payment_approver_ids.filtered(lambda l: l.status == 'checked') else None"/>
                    <t t-set="approver" t-value="doc.vendor_payment_approver_ids.filtered(lambda l: l.status == 'approved').sorted(key=lambda l: l.id)[-1] if doc.vendor_payment_approver_ids.filtered(lambda l: l.status == 'approved') else None"/>

                    <t t-if="not checker">
                        <t t-set="checker" t-value="approver"/>
                    </t>

                    <div class="row" style="margin-top: 200px; font-size: 14px;page-break-inside: avoid;">
                        <!-- Left side: Prepared / Checked / Approved -->
                        <div class="col-8">
                            <p><strong>Prepared By:</strong> <span t-field="doc.submit_user_id.name" /><span t-if="doc.submit_user_id.name">, </span><span t-field="doc.date"/></p>
                            <p><strong>Checked By:</strong>
                                <t t-if="checker">
                                    <span t-out="checker.approval_employee_id.name"/><span t-if="checker.approval_employee_id.name">, </span>
                                    <span t-if="doc.check_date" t-field="doc.check_date"/>
                                    <span t-elif="doc.approve_date" t-field="doc.approve_date"/>
                                </t>
                                <t t-elif="doc.state == 'posted' and doc.config_id and not doc.config_id.need_approval">
                                    <span t-field="doc.submit_user_id.name" /><span t-if="doc.submit_user_id.name">, </span><span t-field="doc.date"/>
                                </t>
                            </p>
                            <p><strong>Approved By:</strong>
                                <t t-if="approver">
                                    <span t-out="approver.approval_employee_id.name"/><span t-if="approver.approval_employee_id.name">, </span>
                                    <span t-field="doc.approve_date"/>
                                </t>
                                <t t-elif="doc.state == 'posted' and doc.config_id and not doc.config_id.need_approval">
                                    <span t-field="doc.submit_user_id.name" /><span t-if="doc.submit_user_id.name">, </span><span t-field="doc.date"/>
                                </t>
                            </p>
                        </div>

                        <!-- Right side: Received By -->
                        <div class="col-4">
                            <p><strong>Received By:</strong></p>
                            <p><strong>Name:</strong></p>
                            <p><strong>Date:</strong></p>
                        </div>
                    </div>

                </div>
            </t>
        </template>

        <template id="payment_voucher_report">
            <t t-call="web.html_container">
                <t t-call="account_payment_report.custom_header_footer_payment_voucher" />
                <t t-foreach="docs" t-as="doc">
                    <t t-set="lang" t-value="doc.partner_id.lang" />
                    <t t-call="account_payment_report.custom_vendor_payment_report" t-lang="lang" />
                </t>
            </t>
        </template>
    </data>
</odoo>