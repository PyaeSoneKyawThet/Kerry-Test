<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>         

        <record id="paperformat_custom_payment_receipt" model="report.paperformat">
            <field name="name">Payment Receipt</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">25</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">25</field>
            <field name="dpi">90</field>
        </record>

        <!-- QWeb Reports -->
        <record id="account_payment_report" model="ir.actions.report">
            <field name="name">Account Payment</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">account_payment_report.payment_report</field>
            <field name="report_file">account_payment_report.payment_report</field>
            <field name="print_report_name">(object._get_report_filename_official_receipt())</field>
            <field name="paperformat_id" ref="account_payment_report.paperformat_custom_payment_receipt"/>
            <field name="attachment"/>           
            <field name="binding_type">report</field>
        </record>
        

    </data>
</odoo>
