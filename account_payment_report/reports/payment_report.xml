<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="custom_header_footer_payment_receipt">
            <div class="header">
                <div style="report_header_style">
                    <div class="row justify-content-end">
                        <div class="col-3 text-end">
                            <span t-field="doc.company_id.logo"
                                t-options="{'widget':'image', 'style': 'height:85px; width:130px'}" />
                        </div>
                    </div>
                    <div style="font-weight:bold; margin-top: -40px;"> 
                        <h4 class="text-center">
                            <span>OFFICIAL RECEIPT</span> 
                        </h4>
                    </div>
                </div>
            </div>

            <div class="footer" style="margin-bottom: -300px  !important;border-top: 1px solid black">                             
                <div class="row">
                    <div class="col-4">
                        <span style="font-size: 15px;" t-if="doc.company_id.name" t-field="doc.company_id.name"></span>
                    </div>
                    <div class="col-4 text-center">
                        <span style="font-size: 12px;">
                            <span t-field="doc.name"/>
                        </span>
                    </div>
                    <div class="col-4 text-end" style="height: 25px;">                        
                        <p style="font-size: 12px;"><small>
                            Page: <span class="page"/> / <span class="topage"/>
                            <span class="ms-2" t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M:%S')"/>
                        </small></p>                                               
                    </div> 
                </div> 
            </div>

        </template>

        <template id="custom_payment_report">
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
                <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat" /> <!-- So that it
                appears in the footer of the report instead of the company VAT if it's set -->

                <div class="page" style="">
                    <div class="row mb-3">
                        <div class="col-7" name="Customer Information">
                            <div class="row mb-2"> <!-- Added space between rows -->
                                <div class="col-4">
                                    <strong>Received From</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.partner_id.complete_name">
                                    <span t-field="doc.partner_id.complete_name" />
                                </div>
                            </div>
                            <div class="row mb-2"> <!-- Added space between rows -->
                                <div class="col-4">
                                    <strong>Customer Code</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.partner_id.ref">
                                    <span t-field="doc.partner_id.ref" />
                                </div>
                            </div>
                            <div class="row mb-2"> <!-- Added space between rows -->
                                <div class="col-4">
                                    <strong>Address</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.partner_id.contact_address_complete">
                                    <span t-field="doc.partner_id.contact_address_complete" />
                                </div>
                            </div>
                            <div class="row mb-2"> <!-- Added space between rows -->
                                <div class="col-4">
                                    <strong>Being Payment For</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.ref">
                                    <span t-field="doc.ref" />
                                </div>
                            </div>
                        </div>

                        <div class="col-5" name="Receipt Information">
                            <div class="row mb-2"> <!-- Added space between rows -->
                                <div class="col-5">
                                    <strong>Official Receipt No</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.official_receipt_no">
                                    <span t-field="doc.official_receipt_no" />
                                </div>
                            </div>
                            <div class="row mb-2"> <!-- Added space between rows -->
                                <div class="col-5">
                                    <strong>Official Receipt Date</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.official_receipt_date">
                                    <span t-field="doc.official_receipt_date" />
                                </div>
                            </div>
                            <div class="row mb-2"> <!-- Added space between rows -->
                                <div class="col-5">
                                    <strong>Currency</strong>
                                </div>
                                <span class="col-1 me-2">:</span>
                                <div class="col-7" t-if="doc.report_currency_id">
                                    <span t-field="doc.report_currency_id.name" />
                                </div>
                            </div>
                        </div>
                    </div>


                    <!-- <table class="table table-borderless border-0 ">
                        <thead>
                            <tr class="border border-dark border-2 border-start-0 border-end-0">
                                <th class="border-0">No</th>
