                                        </t>
                                    </t>
                                    
                                    
                                    <td name="td_balance_due" class="text-end border-0">
                                        <span t-field="line.amount_residual" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                    </td>
                                    <t t-set="total_due_amount" t-value="total_due_amount + line.amount_residual"></t>
                                </tr>
                                <t t-set="index" t-value="index + 1"/>
                            </t>
                            <tr name="Total Row" class="border border-dark border-2 border-start-0 border-end-0" >
                                <td class="border-0"></td>
                                <td class="border-0">
                                    <span>Total Amount</span>
                                </td>
                                <td class="text-end border-0">
                                    <span t-esc="total_invoice_amount" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                </td>
                                <td class="text-end border-0">
                                    <span t-esc="total_payment_amount" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
                                </td>
                                <td class="text-end border-0">
                                    <span t-esc="total_due_amount" t-options="{'widget': 'float', 'precision': 2, 'thousand_separator': True}"/>
