                                <th class="border-0">Amount Balance</th>
                                <th class="border-0">This Payment</th>
                                <th class="border-0">Balance Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_invoice_amount" t-value="0" />
