<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">  
        <record id="seq_receipt_no" model="ir.sequence">
            <field name="name">Official Receipt No</field>
            <field name="code">receipt.no.sequence</field>
            <field name="padding">4</field>
            <field name="prefix">KMTL-REC-%(year)s-%(month)s-</field>
            <field name="company_id" eval="False"></field>
        </record>   

        <record id="seq_receipt_voucher_no" model="ir.sequence">
            <field name="name">Official Receipt No</field>
            <field name="code">voucher.no.sequence</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"></field>
        </record>  
    </data>     
</odoo>