<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <record id="view_move_form_inherit_revise_jornal" model="ir.ui.view">
        <field name="name">view_move_form_inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name='reverse_date' invisible="move_type not in ('entry')" readonly="state == 'posted'"/>
                <field name='reverse_journal' invisible="move_type not in ('entry')" readonly="state == 'posted'"/>
            </xpath>
        </field>
    </record>
      
</odoo>