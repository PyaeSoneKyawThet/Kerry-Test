<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_advance" model="ir.ui.view">
        <field name="name">product.template.advance.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_po_id']" position="after">
                <field name="is_advance"/>          
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_advance" model="ir.ui.view">
        <field name="name">product.template.advance.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="is_advance" optional="hide"/>          
            </xpath>
        </field>
    </record>
</odoo>