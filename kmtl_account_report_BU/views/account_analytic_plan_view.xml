<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_analytic_plan_form_view_inherit_bu" model="ir.ui.view">
        <field name="name">account.analytic.plan.form.inherit.bu</field>
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="is_bu"/>
                <field name="is_sub_bu"/>
            </xpath>
        </field>
    </record>

    <record id="account_analytic_plan_tree_view_inherit_bu" model="ir.ui.view">
        <field name="name">account.analytic.plan.tree.inherit.bu</field>
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_applicability']" position="after">
                <field name="is_bu"/>
                <field name="is_sub_bu"/>
            </xpath>
        </field>
    </record>
</odoo>
