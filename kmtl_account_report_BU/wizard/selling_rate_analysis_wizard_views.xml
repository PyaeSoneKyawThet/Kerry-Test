<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_selling_rate_analysis_wizard_form" model="ir.ui.view">
        <field name="name">selling.rate.analysis.wizard.form</field>
        <field name="model">selling.rate.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Selling Rate Analysis Report by Customers and BU">
                <sheet>
                    <group>
                        <group string="Date">
                            <field name="from_date"/>
                            <field name="to_date"/>
                        </group>
                        <group string="Filters">
                            <field name="bu_ids" widget="many2many_tags"
                                     options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="sub_bu_ids" widget="many2many_tags"
                                     options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="sale_pic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="currency_ids" widget="many2many_tags"
                                     options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Print" type="object" name="action_print" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_selling_rate_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Selling Rate Analysis Report by Customers and BU</field>
        <field name="res_model">selling.rate.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_selling_rate_analysis_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_selling_rate_analysis_report"
              name="Selling Rate Analysis Report by Customers and BU"
              parent="sale.menu_sale_report"
              action="action_selling_rate_analysis_wizard"
              groups="sales_team.group_sale_manager"
              sequence="50"/>
</odoo>
