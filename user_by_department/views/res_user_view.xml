<?xml version="1.0" encoding="UTF-8"?> 
<odoo>
    <record id="view_users_form_inherit_dept" model="ir.ui.view">
        <field name="name">view.users.form.inherit.dept</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml"> 
            <xpath expr="//form/sheet/notebook/page[@name='access_rights']/group[1]" position="after">
                <group string="Multi Departments">
                    <field name="department_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field> 
    </record>
</odoo>