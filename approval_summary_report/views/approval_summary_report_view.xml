<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- tree view -->
    <record id="approval_summary_report_view_tree" model="ir.ui.view"> 
        <field name="name">approval.summary.report.view.tree</field>
        <field name="model">approval.summary.report</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" type="object">
                <field name="request_name" optional="show"/>
                <field name="date" optional="show"/>
                <field name="request_approved_date" optional="show"/>
                <field name="comparison" optional="show"/>
                <field name="rfq_no" optional="show"/>
                <field name="purchase" optional="show"/>
                <field name="request_pay" optional="show"/>
                <field name="rfq_pay" optional="show"/>
                <field name="request_exp" optional="show"/>
                <field name="cash_advance" optional="show"/>
                <field name="pr_type" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="doc_location_id" optional="show"/>
                <field name="payment_type_id" optional="show"/>
                <field name="request_owner_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="location" optional="hide"/>
                <field name="reference" optional="hide"/>
                <field name="vendor_invoice_no" optional="hide"/>
                <field name="without_PO" optional="hide"/>
                <field name="est_delivery_date" optional="hide"/>
                <field name="value_date" optional="hide"/>
                <field name="pay_to_id" optional="hide"/>
                <field name="pay_to_external" optional="hide"/>
                <field name="currency_id" optional="show"/>
                <field name="amount" optional="show" sum="Total"/>   
                <field name="request_status" optional="show"/>             
            </tree>
        </field> 
    </record>


    <record id="approval_summary_report_search_view" model="ir.ui.view">
        <field name="name">approval.summary.report.search</field>
        <field name="model">approval.summary.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_name"/>
                <field name="comparison"/>
                <field name="rfq_no"/>
                <field name="purchase"/>
                <field name="request_pay"/>
                <field name="rfq_pay"/>
                <field name="purchase"/>
                <field name="doc_location_id"/>
                <field name="department_id" filter_domain="[('department_id', 'child_of', raw_value)]"/>
            </search>
        </field>
    </record>


    <record id="action_approval_summary_report" model="ir.actions.act_window">
        <field name="name">Approval Summary</field>
        <field name="res_model">approval.summary.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="approval_summary_report.approval_summary_report_view_tree"/>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="approval_summary_report_search_view"/>
        <field name="context">{}</field>
        <field name="target">current</field>
    </record>


    <menuitem id="menu_approval_summary_report" 
    name="Approval Summary" 
    parent="approvals.approvals_menu_manager"
    action="action_approval_summary_report"
    sequence="100"
    />
</odoo>
