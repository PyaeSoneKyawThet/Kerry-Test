<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Approval Summary Report -->
        <record model="ir.rule" id="all_approval_summary_rule">
            <field name="name">All Approval Summary</field>
            <field name="model_id" ref="approval_summary_report.model_approval_summary_report"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record model="ir.rule" id="approval_summary_by_dept_rule">
            <field name="name">Approval Summary By Department</field>
            <field name="model_id" ref="approval_summary_report.model_approval_summary_report"/>
            <field name="domain_force">['|', ('department_id', '=', False), ('department_id', 'in', user.department_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('approvals.group_approval_user')),(4, ref('approvals.group_approval_manager'))]"/>
        </record>
    </data>
</odoo>
